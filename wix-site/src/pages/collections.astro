</style>

<script>
// Tier tab switching
const tabs = document.querySelectorAll<HTMLButtonElement>('.tier-tab');
const panels = document.querySelectorAll<HTMLElement>('.tier-panel');

tabs.forEach(tab => {
  tab.addEventListener('click', () => {
    const targetId = tab.dataset.panel ?? '';

    tabs.forEach(t => {
      t.classList.remove('tier-tab--active');
      t.setAttribute('aria-selected', 'false');
    });

    panels.forEach(p => p.classList.remove('tier-panel--active'));

    tab.classList.add('tier-tab--active');
    tab.setAttribute('aria-selected', 'true');

    const target = document.getElementById(targetId);
    if (target) target.classList.add('tier-panel--active');
  });
});
</script>
