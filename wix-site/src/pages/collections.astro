---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

let wixProducts = [];
try {
  const { products } = await import('@wix/stores');
  const result = await products.queryProducts().find();
  wixProducts = result.items ?? [];
} catch(e) {
  wixProducts = [];
}
---

<Layout title="Collections — HUE Co." description="Six chain styles. Three metal tiers. Infinite combinations. All permanently yours. Shop HUE Co. permanent jewelry in Santa Cruz, CA.">

<!-- ── Hero ──────────────────────────────────────────────────── -->
<section class="section--dark col-hero">
  <div class="container">
    <span class="eyebrow eyebrow--light">The Collection</span>
    <h1 class="section-title section-title--xl col-hero__title">Wear what lasts.</h1>
    <p class="section-subtitle">Six chain styles. Three metal tiers. Infinite combinations. All permanently yours.</p>
  </div>
</section>

<!-- ── Tier Tabs ─────────────────────────────────────────────── -->
<section class="section--butter section--sm">
  <div class="container">
    <div class="tier-tabs" role="tablist" aria-label="Metal tiers">
      <button class="tier-tab tier-tab--active" role="tab" aria-selected="true" aria-controls="panel-t1" id="tab-t1" data-panel="panel-t1">
        Tier 1
      </button>
      <button class="tier-tab" role="tab" aria-selected="false" aria-controls="panel-t2" id="tab-t2" data-panel="panel-t2">
        Tier 2
      </button>
      <button class="tier-tab" role="tab" aria-selected="false" aria-controls="panel-t3" id="tab-t3" data-panel="panel-t3">
        Tier 3
      </button>
    </div>

    <div class="tier-panels">
      <div class="tier-panel tier-panel--active" id="panel-t1" role="tabpanel" aria-labelledby="tab-t1">
        <div class="tier-panel__inner">
          <div class="tier-panel__badge">T1</div>
          <div class="tier-panel__content">
            <h2 class="tier-panel__name">Stainless Steel PVD</h2>
            <p class="tier-panel__detail">From $42 &middot; Waterproof, gym-proof, everyday wearable</p>
            <p class="tier-panel__desc">Physical Vapor Deposition coating creates a finish that resists scratches, sweat, and salt water. The entry point into permanent jewelry — and the one clients reach for when they want to test the lifestyle before committing to gold.</p>
          </div>
          <div class="tier-panel__price">
            <span class="tier-panel__from">From</span>
            <span class="tier-panel__amount">$42</span>
          </div>
        </div>
      </div>
      <div class="tier-panel" id="panel-t2" role="tabpanel" aria-labelledby="tab-t2">
        <div class="tier-panel__inner">
          <div class="tier-panel__badge">T2</div>
          <div class="tier-panel__content">
            <h2 class="tier-panel__name">14k Gold-Filled &amp; Argentium Silver</h2>
            <p class="tier-panel__detail">From $72 &middot; Hypoallergenic, tarnish-resistant, long-lasting luxury</p>
            <p class="tier-panel__desc">Gold-filled is legally required to contain at least 5% gold by weight — a permanent gold layer that won't flake or peel. Argentium silver is 93.5% pure silver alloyed for superior tarnish resistance. The luxury feel, without the solid gold price point.</p>
          </div>
          <div class="tier-panel__price">
            <span class="tier-panel__from">From</span>
            <span class="tier-panel__amount">$72</span>
          </div>
        </div>
      </div>
      <div class="tier-panel" id="panel-t3" role="tabpanel" aria-labelledby="tab-t3">
        <div class="tier-panel__inner">
          <div class="tier-panel__badge">T3</div>
          <div class="tier-panel__content">
            <h2 class="tier-panel__name">14k Solid Gold</h2>
            <p class="tier-panel__detail">From $145 &middot; Heirloom quality, melt value, the real thing</p>
            <p class="tier-panel__desc">14 karat gold is 58.5% pure gold, alloyed with other metals for wearable durability. Available in yellow and white gold. It has real melt value and real resale value. This is the piece you pass down. The investment you wear every day.</p>
          </div>
          <div class="tier-panel__price">
            <span class="tier-panel__from">From</span>
            <span class="tier-panel__amount">$145</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Chain Styles ───────────────────────────────────────────── -->
<section class="section section--cream">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow eyebrow--dark">Chain Styles</span>
      <h2 class="section-title">Six ways to wear permanence.</h2>
      <p class="section-subtitle">Available 1mm – 3mm. Every style welds in every tier.</p>
    </div>

