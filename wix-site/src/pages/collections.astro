        </div>
      </div>
      <div class="chain-card">
        <div class="photo-block photo-block--square photo-block--warm chain-card__photo">
          <div class="chain-card__label">Cable</div>
        </div>
        <div class="chain-card__body">
          <h3 class="chain-card__name">Cable Chain</h3>
          <p class="chain-card__desc">Classic round links, timeless. The chain that works on every body, every age, every day.</p>
        </div>
      </div>
      <div class="chain-card">
        <div class="photo-block photo-block--square photo-block--warm chain-card__photo">
          <div class="chain-card__label">Figaro</div>
        </div>
