            <td class="compare-table__yes">Yes</td>
            <td class="compare-table__yes">Yes</td>
            <td class="compare-table__yes">Yes</td>
          </tr>
          <tr>
            <td class="compare-table__feature">Resale Value</td>
            <td>Low</td>
            <td>Medium</td>
            <td class="compare-table__highlight">High</td>
          </tr>
          <tr>
