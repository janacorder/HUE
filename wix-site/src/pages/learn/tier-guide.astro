</Layout>

<style is:global>
/* ── Article Lead ───────────────────────────────────────────── */
.article-lead {
  font-family: var(--font-display) !important;
  font-size: clamp(1.1rem, 2vw, 1.35rem) !important;
  font-style: italic;
  line-height: 1.75 !important;
  opacity: 0.8 !important;
  margin-bottom: 48px !important;
}

/* ── Article H3 ─────────────────────────────────────────────── */
.article-h3 {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--butter-dark);
  margin-top: 32px;
  margin-bottom: 12px;
}

/* ── Tier Callouts ──────────────────────────────────────────── */
.tier-callout {
  display: flex;
  align-items: center;
  gap: 32px;
  padding: 28px 32px;
  border-left: 3px solid var(--butter);
  background: var(--warm-white);
  margin: 40px 0;
}

.tier-callout__tier {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 300;
  line-height: 1;
  color: var(--butter-dark);
  flex-shrink: 0;
}

.tier-callout__headline {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--black);
  margin-bottom: 4px;
}

.tier-callout__price {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 400;
  color: var(--charcoal);
  margin-bottom: 2px;
}

.tier-callout__note {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 300;
  opacity: 0.55;
}

.tier-callout--t2 {
  border-left-color: var(--butter-dark);
}

.tier-callout--t3 {
  border-left-color: var(--black);
  background: var(--cream);
}

/* ── Article Table ──────────────────────────────────────────── */
.article-table-wrap {
  margin-top: 40px;
  margin-bottom: 0;
}

@media (max-width: 768px) {
  .tier-callout {
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
}
</style>
