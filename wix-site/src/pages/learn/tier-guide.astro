            <td>14k Solid Gold</td>
          </tr>
          <tr>
            <td class="compare-table__feature">Waterproof</td>
            <td class="compare-table__yes">Yes</td>
            <td class="compare-table__yes">Yes</td>
            <td class="compare-table__yes">Yes</td>
          </tr>
          <tr>
            <td class="compare-table__feature">Hypoallergenic</td>
            <td class="compare-table__yes">Yes</td>
            <td class="compare-table__yes">Yes</td>
            <td class="compare-table__yes">Yes</td>
          </tr>
          <tr>
