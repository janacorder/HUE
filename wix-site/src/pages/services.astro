---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Services — HUE Glint" description="In-studio welds, stacking sessions, Glow & Glint, bridal pop-ups, party events, and aftercare. Every way HUE Glint welds.">

<section class="page-hero section--dark">
  <div class="container">
    <span class="eyebrow">What We Do</span>
    <h1 class="page-hero__title">Every way we weld.</h1>
    <p class="page-hero__sub">One chair, one welder, infinite combinations. Six ways to wear HUE Glint permanently.</p>
  </div>
</section>

<!-- In-Studio Weld -->
<section class="service-section section--cream" id="in-studio">
  <div class="container service-section__inner">
    <div class="service-section__content">
      <span class="eyebrow" style="color:#8B7340">Service 01</span>
      <h2>In-Studio Weld</h2>
      <p>Our signature one-on-one appointment. Sit with your welder, choose your final chain and width from physical samples, and walk out with it permanently welded to your body. The whole thing takes about 30 minutes.</p>
      <ul class="service-list">
        <li>30-minute appointment</li>
        <li>$25 deposit holds your slot</li>
        <li>Remainder settled day-of</li>
        <li>All three metal tiers available</li>
        <li>Up to 3 charms per chain</li>
      </ul>
      <a href="/book" class="btn btn--outline-dark">Book an Appointment</a>
    </div>
    <div class="service-section__price">
      <div class="price-card">
        <div class="price-card__tier">Tier 1</div>
        <div class="price-card__amount">from $42</div>
        <div class="price-card__tier">Tier 2</div>
        <div class="price-card__amount">from $72</div>
        <div class="price-card__tier">Tier 3</div>
        <div class="price-card__amount">from $145</div>
        <div class="price-card__note">$25 deposit required at booking</div>
      </div>
    </div>
  </div>
</section>

<!-- Stacking Session -->
<section class="service-section section--dark" id="stacking">
  <div class="container service-section__inner">
    <div class="service-section__content">
      <span class="eyebrow">Service 02</span>
      <h2>Stacking Session</h2>
      <p>Three or more chains welded in a single sitting. The more you stack, the more you save — 10% off every chain in the session. Perfect for wrist stacks, ankle layering, or a full body composition.</p>
      <ul class="service-list">
        <li>Minimum 3 chains</li>
        <li>10% off every chain</li>
        <li>~60 minute session</li>
        <li>Mix tiers and styles freely</li>
        <li>No maximum chain limit</li>
      </ul>
      <a href="/book" class="btn btn--outline">Book a Stack</a>
    </div>
    <div class="service-section__price">
      <div class="price-card price-card--dark">
        <div class="price-card__tier" style="color:var(--gold)">Discount</div>
        <div class="price-card__amount">10% off</div>
        <div class="price-card__note" style="color:rgba(255,255,255,0.4)">Applied to every chain<br />when 3+ are welded same day</div>
      </div>
    </div>
  </div>
</section>

<!-- Glow & Glint -->
<section class="service-section section--cream" id="glow">
  <div class="container service-section__inner">
    <div class="service-section__content">
      <span class="eyebrow" style="color:#8B7340">Service 03</span>
      <h2>Glow &amp; Glint</h2>
      <p>A same-day collab with our partner studio deSoleil Spray Tanning. Book a professional spray tan and a permanent chain on the same day and save 10% on both services. Look entirely put-together in one afternoon.</p>
      <ul class="service-list">
        <li>Partner: deSoleil Spray Tanning</li>
        <li>10% off both services</li>
        <li>Same-day booking required</li>
        <li>Tan then chain (order matters)</li>
        <li>Available at both locations</li>
      </ul>
      <a href="/book" class="btn btn--outline-dark">Book Glow &amp; Glint</a>
    </div>
    <div class="service-section__price">
      <div class="price-card">
        <div class="price-card__tier">Bundle Savings</div>
        <div class="price-card__amount">10% off</div>
        <div class="price-card__note">both your spray tan<br />&amp; your chain</div>
      </div>
    </div>
  </div>
</section>

<!-- Bridal & Bachelorette -->
<section class="service-section section--dark" id="bridal">
  <div class="container service-section__inner">
    <div class="service-section__content">
      <span class="eyebrow">Service 04</span>
      <h2>Bridal &amp; Bachelorette</h2>
      <p>We bring the studio to you. Our mobile pop-up setup fits in a hotel suite, venue getting-ready room, or private home. Minimum 4 guests. The host always gets a complimentary Tier 1 chain on us.</p>
      <ul class="service-list">
        <li>Minimum 4 guests</li>
        <li>Host receives free Tier 1 chain</li>
        <li>Travel fee: $35 + $2/mile</li>
        <li>Full setup provided</li>
        <li>Mix of tiers available</li>
      </ul>
      <a href="/book" class="btn btn--outline">Inquire About a Pop-Up</a>
    </div>
    <div class="service-section__price">
      <div class="price-card price-card--dark">
        <div class="price-card__tier" style="color:var(--gold)">Per Guest</div>
        <div class="price-card__amount">From $42</div>
        <div class="price-card__tier" style="color:var(--gold)">Travel Fee</div>
        <div class="price-card__amount">$35 + $2/mi</div>
        <div class="price-card__tier" style="color:var(--gold)">Host Gets</div>
        <div class="price-card__amount">Free T1 Chain</div>
      </div>
    </div>
  </div>
</section>

<!-- Party Favor Events -->
<section class="service-section section--cream" id="events">
  <div class="container service-section__inner">
    <div class="service-section__content">
      <span class="eyebrow" style="color:#8B7340">Service 05</span>
      <h2>Party Favor Events</h2>
      <p>Corporate gifting, birthday parties, brand activations, and beyond. Guests choose their tier, get welded on-site, and leave with something permanent. This is the party favor that doesn't end up in a drawer.</p>
      <ul class="service-list">
        <li>Minimum 4 guests</li>
        <li>Host receives a free chain</li>
        <li>Tiered pricing per guest</li>
        <li>Branding options available</li>
        <li>All chain styles available</li>
      </ul>
      <a href="/collaborations" class="btn btn--outline-dark">Inquire About an Event</a>
    </div>
    <div class="service-section__price">
      <div class="price-card">
        <div class="price-card__tier">Tier 1 / guest</div>
        <div class="price-card__amount">$38</div>
        <div class="price-card__tier">Tier 2 / guest</div>
        <div class="price-card__amount">$72</div>
        <div class="price-card__tier">Tier 3 / guest</div>
        <div class="price-card__amount">$175</div>
      </div>
    </div>
  </div>
</section>

<!-- Re-Weld & Aftercare -->
<section class="service-section section--dark" id="reweld">
  <div class="container service-section__inner">
    <div class="service-section__content">
      <span class="eyebrow">Service 06</span>
      <h2>Re-Weld &amp; Aftercare</h2>
      <p>Chains come off sometimes — that's what the 30-day warranty is for. After that, re-welds are affordable and fast. We also do charm swaps, removals, and consultations. We take care of you after the weld, not just during.</p>
      <ul class="service-list">
        <li>30-day weld warranty (free)</li>
        <li>Re-weld after warranty: $20 (T1/T2), $35 (T3)</li>
        <li>Charm swap: $10 + charm cost</li>
        <li>Removal: always FREE</li>
        <li>Consultation: always FREE</li>
      </ul>
      <a href="/book" class="btn btn--outline">Book Aftercare</a>
    </div>
    <div class="service-section__price">
      <div class="price-card price-card--dark">
        <div class="price-card__tier" style="color:var(--gold)">Re-Weld (T1/T2)</div>
        <div class="price-card__amount">$20</div>
        <div class="price-card__tier" style="color:var(--gold)">Re-Weld (T3)</div>
        <div class="price-card__amount">$35</div>
        <div class="price-card__tier" style="color:var(--gold)">Removal</div>
        <div class="price-card__amount">Free</div>
      </div>
    </div>
  </div>
</section>

<!-- Policy Strip -->
<section class="policies section--cream">
  <div class="container">
    <div class="policies__inner">
      <div class="policy">
        <h4>30-Day Weld Warranty</h4>
        <p>If your weld comes undone within 30 days for any reason, we re-weld it at no charge.</p>
      </div>
      <div class="policy__divider"></div>
      <div class="policy">
        <h4>24-Hour Cancellation</h4>
        <p>Cancel or reschedule at least 24 hours before your appointment for a full deposit refund.</p>
      </div>
      <div class="policy__divider"></div>
      <div class="policy">
        <h4>Age Policy</h4>
        <p>Guests under 18 must be accompanied by a parent or legal guardian for the duration of the appointment.</p>
      </div>
    </div>
  </div>
</section>

</Layout>

<style>
  .page-hero { padding: calc(var(--nav-height) + 80px) 0 80px; }
  .page-hero__title { font-size: clamp(48px, 7vw, 96px); font-weight: 300; margin-bottom: 20px; }
  .page-hero__sub { font-size: 16px; color: rgba(255,255,255,0.6); max-width: 480px; line-height: 1.7; }

  .service-section { padding: 80px 0; }
  .service-section__inner { display: grid; grid-template-columns: 1fr 320px; gap: 80px; align-items: start; }
  .service-section h2 { font-size: clamp(32px, 4vw, 48px); margin-bottom: 20px; }
  .service-section p { font-size: 15px; line-height: 1.75; margin-bottom: 28px; color: rgba(0,0,0,0.7); }
  .section--dark .service-section p { color: rgba(255,255,255,0.6); }
  .service-list { list-style: none; margin-bottom: 36px; display: flex; flex-direction: column; gap: 10px; }
  .service-list li { font-size: 13px; padding-left: 20px; position: relative; }
  .service-list li::before { content: '—'; position: absolute; left: 0; color: var(--gold); }
  .section--cream .service-list li { color: rgba(0,0,0,0.7); }
  .section--dark .service-list li { color: rgba(255,255,255,0.6); }

  .price-card {
    background: var(--black); color: var(--white); padding: 40px;
    border: 1px solid rgba(255,255,255,0.08); position: sticky; top: calc(var(--nav-height) + 24px);
  }
  .price-card--dark { background: rgba(255,255,255,0.04); }
  .price-card__tier { font-size: 10px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 4px; margin-top: 20px; }
  .price-card__tier:first-child { margin-top: 0; }
  .price-card__amount { font-family: 'Cormorant Garamond', serif; font-size: 36px; font-weight: 400; color: var(--white); line-height: 1.1; }
  .price-card__note { font-size: 11px; color: rgba(255,255,255,0.35); line-height: 1.5; margin-top: 20px; }
  .section--cream .price-card .price-card__tier { color: rgba(0,0,0,0.45); }
  .section--cream .price-card .price-card__amount { color: var(--black); }
  .section--cream .price-card .price-card__note { color: rgba(0,0,0,0.35); }
  .section--cream .price-card { background: var(--white); border-color: rgba(0,0,0,0.1); color: var(--black); }

  .policies { padding: 64px 0; }
  .policies__inner { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 0; align-items: center; }
  .policy { padding: 0 40px; text-align: center; }
  .policy h4 { font-size: 18px; color: var(--black); margin-bottom: 10px; }
  .policy p { font-size: 13px; color: rgba(0,0,0,0.55); line-height: 1.6; }
  .policy__divider { width: 1px; height: 64px; background: rgba(0,0,0,0.12); }

  @media (max-width: 900px) {
    .service-section__inner { grid-template-columns: 1fr; gap: 40px; }
    .price-card { position: static; }
    .policies__inner { grid-template-columns: 1fr; gap: 32px; }
    .policy__divider { display: none; }
    .policy { padding: 0; }
  }
</style>
