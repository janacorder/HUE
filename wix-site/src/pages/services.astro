---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Services — HUE Co. · Every Way We Weld · Santa Cruz, CA"
  description="In-studio welds, stacking sessions, Glow &amp; Glint, bridal pop-ups, party events, and aftercare. Every way HUE Co. welds permanently."
>

  <!-- ── Hero ────────────────────────────────────────────── -->
  <section class="section--dark services-hero">
    <div class="container services-hero__inner">
      <div class="services-hero__text">
        <span class="eyebrow">What We Do</span>
        <h1 class="section-title section-title--xl services-hero__headline">
          Every way we weld.
        </h1>
        <p class="section-subtitle services-hero__sub">
          One chair. One welder. Six ways to wear HUE Co. permanently.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Services Nav Strip ─────────────────────────────── -->
  <nav class="section--butter services-nav" aria-label="Services navigation">
    <div class="container">
      <div class="services-nav__links">
        <a href="#in-studio" class="services-nav__pill">In-Studio Weld</a>
        <a href="#stacking"  class="services-nav__pill">Stacking Session</a>
        <a href="#glow"      class="services-nav__pill">Glow &amp; Glint</a>
        <a href="#bridal"    class="services-nav__pill">Bridal &amp; Bachelorette</a>
        <a href="#events"    class="services-nav__pill">Party Favor Events</a>
        <a href="#reweld"    class="services-nav__pill">Re-Weld &amp; Aftercare</a>
      </div>
    </div>
  </nav>

  <!-- ── Service 01 — In-Studio Weld ───────────────────── -->
  <section class="section--cream section service-section" id="in-studio">
    <div class="container service-grid">

      <div class="service-text">
        <span class="eyebrow eyebrow--dark">Service 01</span>
        <h2 class="section-title service-headline">In-Studio Weld</h2>
        <p class="service-body">
          Our signature one-on-one appointment. Sit with your welder, feel the physical
          chain samples, choose your exact length, and walk out permanently adorned.
          The whole thing takes about 30 minutes.
        </p>

        <ul class="service-features">
          <li>30-minute appointment</li>
          <li>$25 deposit holds your slot</li>
          <li>Remainder settled day-of</li>
          <li>All three metal tiers available</li>
          <li>Up to 3 charms per chain</li>
        </ul>

        <a href="/book" class="btn btn--outline-dark">Book an Appointment</a>
      </div>

      <aside class="price-card price-card--cream">
        <div class="price-card__header">
          <span class="price-card__label">Pricing</span>
        </div>
        <div class="price-card__tiers">
          <div class="price-card__tier">
            <span class="price-card__tier-name">Tier 1 — Stainless Steel</span>
            <span class="price-card__tier-amount">from $42</span>
          </div>
          <div class="price-card__tier">
            <span class="price-card__tier-name">Tier 2 — Gold-Filled / Silver</span>
            <span class="price-card__tier-amount">from $72</span>
          </div>
          <div class="price-card__tier">
            <span class="price-card__tier-name">Tier 3 — Solid Gold</span>
            <span class="price-card__tier-amount">from $145</span>
          </div>
        </div>
        <p class="price-card__note">$25 deposit required at booking.</p>
        <a href="/book" class="btn btn--gold price-card__cta">Book Now</a>
      </aside>

    </div>
  </section>

  <!-- ── Service 02 — Stacking Session ─────────────────── -->
  <section class="section--dark section service-section" id="stacking">
    <div class="container service-grid">

      <div class="service-text">
        <span class="eyebrow">Service 02</span>
        <h2 class="section-title service-headline">Stacking Session</h2>
        <p class="service-body">
          Three or more chains welded in a single sitting. The more you stack, the more
          you save — 10% off every chain in the session. Perfect for wrist stacks, ankle
          layering, or a full body composition.
        </p>

        <ul class="service-features service-features--light">
          <li>Minimum 3 chains</li>
          <li>10% off every chain</li>
          <li>Approximately 60-minute session</li>
          <li>Mix tiers and styles freely</li>
          <li>No maximum chain limit</li>
        </ul>

        <a href="/book" class="btn btn--outline">Book a Session</a>
      </div>

      <aside class="price-card price-card--dark">
        <div class="price-card__header">
          <span class="price-card__label price-card__label--light">Discount</span>
        </div>
        <div class="price-card__feature-number">10%</div>
        <p class="price-card__feature-desc">
          Off every chain when 3 or more are welded the same day. Mix and match any tier.
        </p>
        <a href="/book" class="btn btn--gold price-card__cta">Book a Session</a>
      </aside>

    </div>
  </section>

  <!-- ── Service 03 — Glow & Glint ─────────────────────── -->
  <section class="section--cream section service-section" id="glow">
    <div class="container service-grid">

      <div class="service-text">
        <span class="eyebrow eyebrow--dark">Service 03</span>
        <h2 class="section-title service-headline">Glow &amp; Glint</h2>
        <p class="service-body">
          A same-day collaboration with our partner deSoleil Spray Tanning. Professional
          spray tan and a permanent chain on the same day — save 10% on both services.
          Look entirely put-together in one afternoon.
        </p>

        <ul class="service-features">
          <li>Partner: deSoleil Spray Tanning</li>
          <li>10% off both services</li>
          <li>Same-day booking required</li>
          <li>Tan before chain (order matters)</li>
          <li>Available at both locations</li>
        </ul>

        <a href="/book" class="btn btn--outline-dark">Book Glow &amp; Glint</a>
      </div>

      <aside class="price-card price-card--cream">
        <div class="price-card__header">
          <span class="price-card__label">Partner Discount</span>
        </div>
        <div class="price-card__feature-number price-card__feature-number--dark">10%</div>
        <p class="price-card__feature-desc price-card__feature-desc--dark">
          Off both your spray tan and permanent chain when booked on the same day.
        </p>
        <p class="price-card__partner">
          In partnership with deSoleil Spray Tanning
        </p>
        <a href="/book" class="btn btn--gold price-card__cta">Book Now</a>
      </aside>

    </div>
  </section>

  <!-- ── Service 04 — Bridal & Bachelorette ────────────── -->
  <section class="section--dark section service-section" id="bridal">
    <div class="container service-grid">

      <div class="service-text">
        <span class="eyebrow">Service 04</span>
        <h2 class="section-title service-headline">Bridal &amp; Bachelorette</h2>
        <p class="service-body">
          We bring the full studio to your venue. Our mobile pop-up setup fits in a hotel
          suite, getting-ready room, or private home. Minimum 4 guests. The host always
          receives a complimentary Tier 1 chain.
        </p>

        <ul class="service-features service-features--light">
          <li>Minimum 4 guests</li>
          <li>Host receives free Tier 1 chain</li>
          <li>Travel fee: $35 + $2 per mile</li>
          <li>Full setup provided</li>
          <li>All chain styles available</li>
        </ul>

        <a href="/book" class="btn btn--outline">Book a Bridal Event</a>
      </div>

      <aside class="price-card price-card--dark">
        <div class="price-card__header">
          <span class="price-card__label price-card__label--light">Per Guest Pricing</span>
        </div>
        <div class="price-card__tiers price-card__tiers--light">
          <div class="price-card__tier price-card__tier--light">
            <span class="price-card__tier-name">Per guest</span>
            <span class="price-card__tier-amount">from $42</span>
          </div>
          <div class="price-card__tier price-card__tier--light">
            <span class="price-card__tier-name">Travel fee</span>
            <span class="price-card__tier-amount">$35 + $2/mi</span>
          </div>
          <div class="price-card__tier price-card__tier--light">
            <span class="price-card__tier-name">Host chain</span>
            <span class="price-card__tier-amount">Free (T1)</span>
          </div>
        </div>
        <a href="/book" class="btn btn--gold price-card__cta">Book an Event</a>
      </aside>

    </div>
  </section>

  <!-- ── Service 05 — Party Favor Events ───────────────── -->
  <section class="section--cream section service-section" id="events">
    <div class="container service-grid">

      <div class="service-text">
        <span class="eyebrow eyebrow--dark">Service 05</span>
        <h2 class="section-title service-headline">Party Favor Events</h2>
        <p class="service-body">
          Corporate gifting, birthday parties, brand activations. Guests choose their tier,
          get welded on-site, and leave with something permanent. This is the party favor
          that doesn't end up in a drawer.
        </p>

        <ul class="service-features">
          <li>Minimum 4 guests</li>
          <li>Host receives a free chain</li>
          <li>Tiered pricing per guest</li>
          <li>Branding options available</li>
          <li>All chain styles</li>
        </ul>

        <a href="/book" class="btn btn--outline-dark">Inquire About Events</a>
      </div>

      <aside class="price-card price-card--cream">
        <div class="price-card__header">
          <span class="price-card__label">Per-Guest Pricing</span>
        </div>
        <div class="price-card__tiers">
          <div class="price-card__tier">
            <span class="price-card__tier-name">Tier 1 / guest</span>
            <span class="price-card__tier-amount">$38</span>
          </div>
          <div class="price-card__tier">
            <span class="price-card__tier-name">Tier 2 / guest</span>
            <span class="price-card__tier-amount">$72</span>
          </div>
          <div class="price-card__tier">
            <span class="price-card__tier-name">Tier 3 / guest</span>
            <span class="price-card__tier-amount">$175</span>
          </div>
        </div>
        <p class="price-card__note">Minimum 4 guests. Host chain included.</p>
        <a href="/book" class="btn btn--gold price-card__cta">Get a Quote</a>
      </aside>

    </div>
  </section>

  <!-- ── Service 06 — Re-Weld & Aftercare ──────────────── -->
  <section class="section--dark section service-section" id="reweld">
    <div class="container service-grid">

      <div class="service-text">
        <span class="eyebrow">Service 06</span>
        <h2 class="section-title service-headline">Re-Weld &amp; Aftercare</h2>
        <p class="service-body">
          Chains come off sometimes — that's what the 30-day warranty is for. After that,
          re-welds are fast and affordable. We also do charm swaps, removals, and
          consultations. We take care of you after the weld, not just during.
        </p>

        <ul class="service-features service-features--light">
          <li>30-day weld warranty — free re-weld</li>
          <li>Re-weld after warranty: $20 (T1/T2), $35 (T3)</li>
          <li>Charm swap: $10 + charm cost</li>
          <li>Removal: always FREE</li>
          <li>Consultation: always FREE</li>
        </ul>

        <a href="/book" class="btn btn--outline">Book a Re-Weld</a>
      </div>

      <aside class="price-card price-card--dark">
        <div class="price-card__header">
          <span class="price-card__label price-card__label--light">Aftercare Pricing</span>
        </div>
        <div class="price-card__tiers price-card__tiers--light">
          <div class="price-card__tier price-card__tier--light">
            <span class="price-card__tier-name">Re-Weld T1 / T2</span>
            <span class="price-card__tier-amount">$20</span>
          </div>
          <div class="price-card__tier price-card__tier--light">
            <span class="price-card__tier-name">Re-Weld T3</span>
            <span class="price-card__tier-amount">$35</span>
          </div>
          <div class="price-card__tier price-card__tier--light">
            <span class="price-card__tier-name">Removal</span>
            <span class="price-card__tier-amount">Free</span>
          </div>
        </div>
        <p class="price-card__note price-card__note--light">First 30 days covered by warranty at no charge.</p>
        <a href="/book" class="btn btn--gold price-card__cta">Book Aftercare</a>
      </aside>

    </div>
  </section>

  <!-- ── Policy Strip ───────────────────────────────────── -->
  <section class="section--butter section--sm policy-strip">
    <div class="container">
      <div class="policy-row">

        <div class="policy-item">
          <h3 class="policy-title">30-Day Weld Warranty</h3>
          <p class="policy-body">
            If your weld comes undone within 30 days, we re-weld it at no charge.
          </p>
        </div>

        <div class="policy-divider"></div>

        <div class="policy-item">
          <h3 class="policy-title">24-Hour Cancellation</h3>
          <p class="policy-body">
            Cancel or reschedule at least 24 hours before for a full deposit refund.
          </p>
        </div>

        <div class="policy-divider"></div>

        <div class="policy-item">
          <h3 class="policy-title">Age Policy</h3>
          <p class="policy-body">
            Guests under 18 must be accompanied by a parent or legal guardian.
          </p>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style is:global>

  /* ── Services Hero ─────────────────────────────────────── */
  .services-hero {
    padding-top: calc(var(--nav-height) + 80px);
    padding-bottom: 80px;
  }

  .services-hero__inner {
    max-width: 760px;
  }

  .services-hero__headline {
    color: var(--warm-white);
    margin-top: 8px;
    margin-bottom: 0;
  }

  .services-hero__sub {
    color: rgba(254, 252, 248, 0.58);
    max-width: 44ch;
  }

  /* ── Services Nav ──────────────────────────────────────── */
  .services-nav {
    padding-block: 0;
    border-top: 1px solid rgba(10, 10, 10, 0.1);
    border-bottom: 1px solid rgba(10, 10, 10, 0.1);
  }

  .services-nav .container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .services-nav .container::-webkit-scrollbar {
    display: none;
  }

  .services-nav__links {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-block: 16px;
    white-space: nowrap;
  }

  .services-nav__pill {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--black);
    padding: 7px 16px;
    border: 1px solid rgba(10, 10, 10, 0.2);
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease);
    flex-shrink: 0;
  }

  .services-nav__pill:hover {
    background-color: var(--black);
    border-color: var(--black);
    color: var(--warm-white);
  }

  /* ── Service Layout ────────────────────────────────────── */
  .service-section {
    position: relative;
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 80px;
    align-items: start;
  }

  .service-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service-headline {
    margin-top: 8px;
    margin-bottom: 20px;
  }

  /* cream sections */
  .section--cream .service-headline {
    color: var(--charcoal);
  }

  /* dark sections */
  .section--dark .service-headline {
    color: var(--warm-white);
  }

  .service-body {
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    max-width: 56ch;
    margin-bottom: 32px;
  }

  .section--cream .service-body {
    color: rgba(42, 40, 32, 0.68);
  }

  .section--dark .service-body {
    color: rgba(254, 252, 248, 0.6);
  }

  .service-features {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 40px;
  }

  .service-features li {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.65;
    padding: 10px 0 10px 16px;
    border-left: 1px solid var(--butter);
    position: relative;
  }

  .service-features li::before {
    content: '\2014';
    position: absolute;
    left: -20px;
    opacity: 0;
  }

  .section--cream .service-features li {
    color: var(--charcoal);
    border-color: var(--butter-dark);
  }

  .section--dark .service-features li {
    color: rgba(254, 252, 248, 0.65);
    border-color: var(--butter);
  }

  /* ── Price Cards ───────────────────────────────────────── */
  .price-card {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: sticky;
    top: calc(var(--nav-height) + 24px);
  }

  .price-card--cream {
    background-color: var(--black);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .price-card--dark {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .price-card__header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .price-card--cream .price-card__header {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .price-card--dark .price-card__header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .price-card__label {
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--butter);
  }

  .price-card__label--light {
    color: var(--butter);
  }

  .price-card__tiers {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 24px;
  }

  .price-card__tier {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    gap: 12px;
  }

  .price-card__tier:last-child {
    border-bottom: none;
  }

  .price-card__tier--light {
    border-bottom-color: rgba(255, 255, 255, 0.07);
  }

  .price-card__tier-name {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: rgba(254, 252, 248, 0.5);
  }

  .price-card__tier-amount {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--butter);
    flex-shrink: 0;
  }

  .price-card__feature-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 300;
    color: var(--butter);
    line-height: 1;
    margin-bottom: 16px;
  }

  .price-card__feature-number--dark {
    color: var(--butter-dark);
  }

  .price-card__feature-desc {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .section--dark .price-card--dark .price-card__feature-desc {
    color: rgba(254, 252, 248, 0.5);
  }

  .price-card__feature-desc--dark {
    color: rgba(42, 40, 32, 0.6);
  }

  .price-card__note {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: rgba(254, 252, 248, 0.35);
    margin-bottom: 28px;
    line-height: 1.55;
  }

  .price-card__note--light {
    color: rgba(254, 252, 248, 0.35);
  }

  .price-card__partner {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-style: italic;
    font-weight: 300;
    color: rgba(42, 40, 32, 0.5);
    margin-bottom: 28px;
    line-height: 1.5;
  }

  .price-card__cta {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  @media (max-width: 960px) {
    .service-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .price-card {
      position: static;
    }
  }

  /* ── Policy Strip ──────────────────────────────────────── */
  .policy-row {
    display: flex;
    align-items: flex-start;
  }

  .policy-item {
    flex: 1;
    padding: 8px 32px;
    text-align: center;
  }

  .policy-item:first-child {
    padding-left: 0;
  }

  .policy-item:last-child {
    padding-right: 0;
  }

  .policy-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--black);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .policy-body {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(10, 10, 10, 0.62);
  }

  .policy-divider {
    width: 1px;
    align-self: stretch;
    background-color: rgba(10, 10, 10, 0.18);
    flex-shrink: 0;
    margin-block: 8px;
  }

  @media (max-width: 768px) {
    .policy-row {
      flex-direction: column;
      gap: 0;
    }

    .policy-item {
      padding: 28px 0;
      border-bottom: 1px solid rgba(10, 10, 10, 0.12);
    }

    .policy-item:last-child {
      border-bottom: none;
    }

    .policy-divider {
      display: none;
    }
  }

</style>
