---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Design Your Chain & Book — HUE Glint" description="Design your permanent jewelry step by step. Choose body location, metal tier, chain style, width, and charms. See your price live, then book with a $25 deposit.">

<section class="configurator-hero section--dark">
  <div class="container">
    <span class="eyebrow">Build Your Chain</span>
    <h1>Design &amp; Book</h1>
    <p>Choose every detail below. Your price updates live. Book with a $25 deposit.</p>
  </div>
</section>

<div class="configurator-page section--cream">
  <div class="container">
    <div class="configurator-layout">

      <!-- Step-by-step form -->
      <div class="config-steps">

        <!-- Step 1: Location -->
        <div class="config-step" id="step-location">
          <div class="config-step__header">
            <span class="config-step__num">01</span>
            <h2>Where are we welding?</h2>
          </div>
          <div class="location-grid">
            {['Wrist', 'Ankle', 'Neck', 'Finger', 'Upper Arm', 'Toe'].map(loc => (
              <button class="location-btn" data-location={loc.toLowerCase().replace(' ','-')}>
                <span class="location-btn__name">{loc}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Step 2: Tier -->
        <div class="config-step" id="step-tier">
          <div class="config-step__header">
            <span class="config-step__num">02</span>
            <h2>Which metal tier?</h2>
          </div>
          <div class="tier-select">
            <button class="tier-btn" data-tier="1" data-base="30" data-per-inch="1.75">
              <span class="tier-btn__label">Tier 1</span>
              <span class="tier-btn__name">Stainless PVD</span>
              <span class="tier-btn__price">from $42</span>
            </button>
            <button class="tier-btn tier-btn--featured" data-tier="2" data-base="45" data-per-inch="3.75">
              <span class="tier-btn__badge">Most Popular</span>
              <span class="tier-btn__label">Tier 2</span>
              <span class="tier-btn__name">14k Gold-Filled / Silver</span>
              <span class="tier-btn__price">from $72</span>
            </button>
            <button class="tier-btn" data-tier="3" data-base="75" data-per-inch="10.00">
              <span class="tier-btn__label">Tier 3</span>
              <span class="tier-btn__name">14k Solid Gold</span>
              <span class="tier-btn__price">from $145</span>
            </button>
          </div>
        </div>

        <!-- Step 3: Chain Style -->
        <div class="config-step" id="step-style">
          <div class="config-step__header">
            <span class="config-step__num">03</span>
            <h2>Choose your chain style</h2>
          </div>
          <div class="style-grid">
            {[
              { id: 'box', name: 'Box', desc: 'Clean square links' },
              { id: 'cable', name: 'Cable', desc: 'Classic oval links' },
              { id: 'figaro', name: 'Figaro', desc: 'Italian pattern' },
              { id: 'rope', name: 'Rope', desc: 'Twisted spiral' },
              { id: 'snake', name: 'Snake', desc: 'Smooth & sleek' },
              { id: 'curb', name: 'Curb', desc: 'Flat interlocking' },
            ].map(s => (
              <button class="style-btn" data-style={s.id}>
                <div class="style-btn__preview"></div>
                <span class="style-btn__name">{s.name}</span>
                <span class="style-btn__desc">{s.desc}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Step 4: Width -->
        <div class="config-step" id="step-width">
          <div class="config-step__header">
            <span class="config-step__num">04</span>
            <h2>Select width &amp; estimate length</h2>
          </div>
          <div class="width-options">
            <div class="width-group">
              <label>Chain Width</label>
              <div class="width-btns">
                {['1mm', '1.5mm', '2mm', '3mm'].map(w => (
                  <button class="width-btn" data-width={w}>{w}</button>
                ))}
              </div>
            </div>
            <div class="width-group">
              <label>Estimated Length (inches)</label>
              <div class="length-control">
                <button class="length-btn" id="length-dec">−</button>
                <span id="length-display">6</span>
                <button class="length-btn" id="length-inc">+</button>
                <span class="length-unit">in</span>
              </div>
              <p class="length-hint">Typical wrist: 6–7" &nbsp;·&nbsp; Ankle: 9–10" &nbsp;·&nbsp; Neck: 14–16"</p>
            </div>
          </div>
        </div>

        <!-- Step 5: Charms -->
        <div class="config-step" id="step-charms">
          <div class="config-step__header">
            <span class="config-step__num">05</span>
            <h2>Add charms <span class="optional">(optional — up to 3)</span></h2>
          </div>
          <div class="charms-select" id="charms-container">
            {[
              { id: 'star', name: 'Star', t1: 12, t2: 28, t3: 75 },
              { id: 'moon', name: 'Moon', t1: 12, t2: 28, t3: 75 },
              { id: 'heart', name: 'Heart', t1: 12, t2: 28, t3: 75 },
              { id: 'evil-eye', name: 'Evil Eye', t1: 12, t2: 28, t3: 75 },
              { id: 'initial', name: 'Initial', t1: 12, t2: 28, t3: 75 },
              { id: 'butterfly', name: 'Butterfly', t1: 12, t2: 28, t3: 75 },
              { id: 'lightning', name: 'Lightning Bolt', t1: 12, t2: 28, t3: 75 },
              { id: 'infinity', name: 'Infinity', t1: 12, t2: 28, t3: 75 },
              { id: 'sunburst', name: 'Sunburst', t1: 12, t2: 28, t3: 75 },
              { id: 'zodiac', name: 'Zodiac', t1: 18, t2: 40, t3: 95 },
              { id: 'pearl', name: 'Pearl Drop', t1: 15, t2: 35, t3: 85 },
              { id: 'lock', name: 'Lock & Key', t1: 20, t2: 45, t3: 110 },
            ].map(c => (
              <button class="charm-btn" data-charm={c.id} data-t1={c.t1} data-t2={c.t2} data-t3={c.t3}>
                <div class="charm-btn__icon"></div>
                <span class="charm-btn__name">{c.name}</span>
                <span class="charm-btn__price" id={`charm-price-${c.id}`}>${c.t1}</span>
              </button>
            ))}
          </div>
        </div>

      </div>

      <!-- Live Price Calculator + Booking Form -->
      <div class="config-sidebar">
        <div class="price-calculator" id="price-calc">
          <h3>Your Design</h3>
          <div class="calc-row"><span>Location</span><strong id="calc-location">—</strong></div>
          <div class="calc-row"><span>Metal tier</span><strong id="calc-tier">—</strong></div>
          <div class="calc-row"><span>Chain style</span><strong id="calc-style">—</strong></div>
          <div class="calc-row"><span>Width</span><strong id="calc-width">—</strong></div>
          <div class="calc-row"><span>Length</span><strong id="calc-length">6 in</strong></div>
          <div class="calc-row"><span>Charms</span><strong id="calc-charms">None</strong></div>
          <div class="calc-divider"></div>
          <div class="calc-row"><span>Chain cost</span><strong id="calc-chain">—</strong></div>
          <div class="calc-row"><span>Weld fee</span><strong id="calc-weld">—</strong></div>
          <div class="calc-row"><span>Charms</span><strong id="calc-charm-total">$0</strong></div>
          <div class="calc-total">
            <span>Total</span>
            <strong id="calc-total">—</strong>
          </div>
          <p class="calc-note">$25 deposit due at booking.<br />Remainder settled at the studio.</p>
        </div>

        <div class="booking-form-wrap">
          <h3>Book Your Appointment</h3>
          <form class="booking-form" id="booking-form">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" placeholder="Your Name" required />
            </div>
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email" placeholder="you@email.com" required />
            </div>
            <div class="form-group">
              <label>Phone</label>
              <input type="tel" name="phone" placeholder="(831) 000-0000" />
            </div>
            <div class="form-group">
              <label>Preferred Date</label>
              <input type="date" name="date" />
            </div>
            <div class="form-group">
              <label>Preferred Time</label>
              <select name="time">
                <option value="">Select a time</option>
                <option>10:00 AM</option>
                <option>11:00 AM</option>
                <option>12:00 PM</option>
                <option>1:00 PM</option>
                <option>2:00 PM</option>
                <option>3:00 PM</option>
                <option>4:00 PM</option>
                <option>5:00 PM</option>
              </select>
            </div>
            <div class="form-group">
              <label>Notes</label>
              <textarea name="notes" rows="3" placeholder="Any questions or special requests..."></textarea>
            </div>
            <button type="submit" class="btn btn--gold" style="width:100%;text-align:center">
              Reserve with $25 Deposit →
            </button>
            <p class="form-note">Deposit is fully refundable with 24hr+ cancellation notice.</p>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>

</Layout>

<style>
  .configurator-hero {
    padding: calc(var(--nav-height) + 64px) 0 64px;
  }
  .configurator-hero h1 { font-size: clamp(40px, 6vw, 80px); margin-bottom: 16px; }
  .configurator-hero p { font-size: 15px; color: rgba(255,255,255,0.6); }

  .configurator-page { padding: 64px 0 96px; }
  .configurator-layout { display: grid; grid-template-columns: 1fr 360px; gap: 64px; align-items: start; }

  /* Config Steps */
  .config-steps { display: flex; flex-direction: column; gap: 0; }
  .config-step { padding: 40px 0; border-bottom: 1px solid rgba(0,0,0,0.1); }
  .config-step:last-child { border-bottom: none; }
  .config-step__header { display: flex; align-items: baseline; gap: 20px; margin-bottom: 28px; }
  .config-step__num {
    font-family: 'Cormorant Garamond', serif; font-size: 48px; color: rgba(0,0,0,0.08); line-height: 1;
  }
  .config-step h2 { font-size: 24px; color: var(--black); }
  .optional { font-size: 14px; font-weight: 400; color: rgba(0,0,0,0.4); }

  /* Location */
  .location-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .location-btn {
    padding: 20px 16px; background: var(--white); border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer; font-family: 'Montserrat', sans-serif; transition: all 0.15s;
  }
  .location-btn:hover { border-color: rgba(0,0,0,0.3); }
  .location-btn.active { background: var(--black); border-color: var(--black); }
  .location-btn.active .location-btn__name { color: var(--white); }
  .location-btn__name { font-size: 13px; font-weight: 500; letter-spacing: 0.06em; color: var(--black); display: block; }

  /* Tier Select */
  .tier-select { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .tier-btn {
    padding: 24px 16px; background: var(--white); border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer; font-family: 'Montserrat', sans-serif; transition: all 0.15s;
    display: flex; flex-direction: column; gap: 4px; text-align: left; position: relative;
  }
  .tier-btn:hover { border-color: rgba(0,0,0,0.3); }
  .tier-btn.active { border-color: var(--black); background: rgba(0,0,0,0.03); }
  .tier-btn--featured { border-color: rgba(139,115,64,0.3); background: rgba(201,168,76,0.04); }
  .tier-btn--featured.active { border-color: #8B7340; }
  .tier-btn__badge {
    position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
    background: #8B7340; color: var(--white); font-size: 9px; letter-spacing: 0.1em;
    text-transform: uppercase; padding: 3px 10px;
  }
  .tier-btn__label { font-size: 10px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: #8B7340; }
  .tier-btn__name { font-size: 13px; font-weight: 500; color: var(--black); }
  .tier-btn__price { font-family: 'Cormorant Garamond', serif; font-size: 22px; color: var(--black); }

  /* Style Grid */
  .style-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .style-btn {
    padding: 20px 16px; background: var(--white); border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer; font-family: 'Montserrat', sans-serif; transition: all 0.15s; text-align: left;
  }
  .style-btn:hover { border-color: rgba(0,0,0,0.3); }
  .style-btn.active { background: var(--black); border-color: var(--black); }
  .style-btn.active .style-btn__name, .style-btn.active .style-btn__desc { color: var(--white); }
  .style-btn__preview { height: 32px; background: rgba(0,0,0,0.06); margin-bottom: 12px; border-radius: 1px; }
  .style-btn.active .style-btn__preview { background: rgba(255,255,255,0.1); }
  .style-btn__name { font-size: 13px; font-weight: 500; color: var(--black); display: block; margin-bottom: 4px; }
  .style-btn__desc { font-size: 11px; color: rgba(0,0,0,0.45); display: block; }

  /* Width */
  .width-options { display: flex; flex-direction: column; gap: 24px; }
  .width-group label { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(0,0,0,0.45); display: block; margin-bottom: 10px; }
  .width-btns { display: flex; gap: 8px; }
  .width-btn {
    padding: 12px 20px; background: var(--white); border: 1px solid rgba(0,0,0,0.12);
    font-family: 'Montserrat', sans-serif; font-size: 13px; cursor: pointer; transition: all 0.15s;
  }
  .width-btn:hover { border-color: rgba(0,0,0,0.3); }
  .width-btn.active { background: var(--black); border-color: var(--black); color: var(--white); }
  .length-control { display: flex; align-items: center; gap: 0; }
  .length-btn {
    width: 44px; height: 44px; background: var(--white); border: 1px solid rgba(0,0,0,0.12);
    font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .length-btn:hover { background: rgba(0,0,0,0.05); }
  #length-display {
    width: 64px; height: 44px; background: var(--white); border: 1px solid rgba(0,0,0,0.12);
    border-left: none; border-right: none; display: flex; align-items: center; justify-content: center;
    font-family: 'Cormorant Garamond', serif; font-size: 24px;
  }
  .length-unit { margin-left: 12px; font-size: 13px; color: rgba(0,0,0,0.4); }
  .length-hint { font-size: 11px; color: rgba(0,0,0,0.4); margin-top: 8px; }

  /* Charms */
  .charms-select { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .charm-btn {
    padding: 16px 12px; background: var(--white); border: 1px solid rgba(0,0,0,0.12);
    cursor: pointer; font-family: 'Montserrat', sans-serif; transition: all 0.15s;
    display: flex; flex-direction: column; align-items: center; gap: 6px;
  }
  .charm-btn:hover { border-color: rgba(0,0,0,0.3); }
  .charm-btn.active { border-color: #8B7340; background: rgba(201,168,76,0.06); }
  .charm-btn__icon { width: 36px; height: 36px; background: rgba(0,0,0,0.05); border-radius: 50%; }
  .charm-btn.active .charm-btn__icon { background: rgba(139,115,64,0.15); }
  .charm-btn__name { font-size: 11px; font-weight: 500; color: var(--black); text-align: center; }
  .charm-btn__price { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: #8B7340; }

  /* Sidebar */
  .config-sidebar { position: sticky; top: calc(var(--nav-height) + 24px); display: flex; flex-direction: column; gap: 24px; }
  .price-calculator { background: var(--black); color: var(--white); padding: 40px; }
  .price-calculator h3 { font-size: 20px; margin-bottom: 24px; }
  .calc-row { display: flex; justify-content: space-between; align-items: baseline; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .calc-row span { font-size: 12px; color: rgba(255,255,255,0.45); }
  .calc-row strong { font-size: 14px; color: var(--white); }
  .calc-divider { height: 1px; background: rgba(255,255,255,0.1); margin: 8px 0; }
  .calc-total { display: flex; justify-content: space-between; align-items: baseline; padding: 16px 0 0; }
  .calc-total span { font-size: 13px; color: rgba(255,255,255,0.5); }
  .calc-total strong { font-family: 'Cormorant Garamond', serif; font-size: 40px; color: var(--gold); font-weight: 400; }
  .calc-note { font-size: 11px; color: rgba(255,255,255,0.3); line-height: 1.5; margin-top: 16px; }

  .booking-form-wrap { background: var(--white); padding: 40px; border: 1px solid rgba(0,0,0,0.08); }
  .booking-form-wrap h3 { font-size: 20px; color: var(--black); margin-bottom: 24px; }
  .booking-form { display: flex; flex-direction: column; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 10px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(0,0,0,0.45); }
  .form-group input, .form-group select, .form-group textarea {
    background: #FAFAFA; border: 1px solid rgba(0,0,0,0.12); padding: 12px 14px;
    font-family: 'Montserrat', sans-serif; font-size: 13px; color: var(--black); outline: none;
    transition: border-color 0.15s;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: rgba(139,115,64,0.5); }
  .form-note { font-size: 11px; color: rgba(0,0,0,0.4); text-align: center; margin-top: 4px; }

  @media (max-width: 1024px) {
    .configurator-layout { grid-template-columns: 1fr; }
    .config-sidebar { position: static; }
  }
  @media (max-width: 600px) {
    .location-grid, .tier-select, .style-grid { grid-template-columns: repeat(2, 1fr); }
    .charms-select { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  let state = { tier: null, location: null, style: null, width: null, length: 6, charms: [] };
  const WELD = { '1': 30, '2': 45, '3': 75 };
  const PER_INCH = { '1': 1.75, '2': 3.75, '3': 10 };

  function updatePrice() {
    const t = state.tier;
    document.getElementById('calc-location').textContent = state.location ? capitalize(state.location.replace('-',' ')) : '—';
    document.getElementById('calc-tier').textContent = t ? `Tier ${t}` : '—';
    document.getElementById('calc-style').textContent = state.style ? capitalize(state.style) : '—';
    document.getElementById('calc-width').textContent = state.width || '—';
    document.getElementById('calc-length').textContent = state.length + ' in';
    document.getElementById('calc-charms').textContent = state.charms.length ? state.charms.join(', ') : 'None';

    if (!t) { document.getElementById('calc-total').textContent = '—'; return; }

    const chainCost = +(PER_INCH[t] * state.length).toFixed(2);
    const weldFee = WELD[t];
    const charmTotal = state.charms.reduce((sum, id) => {
      const btn = document.querySelector(`.charm-btn[data-charm="${id}"]`);
      return sum + (btn ? +btn.dataset[`t${t}`] : 0);
    }, 0);
    const total = chainCost + weldFee + charmTotal;

    document.getElementById('calc-chain').textContent = `$${chainCost.toFixed(2)}`;
    document.getElementById('calc-weld').textContent = `$${weldFee}`;
    document.getElementById('calc-charm-total').textContent = `$${charmTotal}`;
    document.getElementById('calc-total').textContent = `$${total.toFixed(2)}`;

    // Update charm prices shown based on selected tier
    document.querySelectorAll('.charm-btn').forEach(btn => {
      const priceEl = btn.querySelector('.charm-btn__price');
      if (priceEl) priceEl.textContent = `$${btn.dataset[`t${t}`]}`;
    });
  }

  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  // Location
  document.querySelectorAll('.location-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.location-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.location = btn.dataset.location;
      updatePrice();
    });
  });

  // Tier
  document.querySelectorAll('.tier-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tier-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.tier = btn.dataset.tier;
      updatePrice();
    });
  });

  // Style
  document.querySelectorAll('.style-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.style-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.style = btn.dataset.style;
      updatePrice();
    });
  });

  // Width
  document.querySelectorAll('.width-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.width-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.width = btn.dataset.width;
      updatePrice();
    });
  });

  // Length
  document.getElementById('length-dec')?.addEventListener('click', () => {
    if (state.length > 3) { state.length--; document.getElementById('length-display').textContent = state.length; updatePrice(); }
  });
  document.getElementById('length-inc')?.addEventListener('click', () => {
    if (state.length < 24) { state.length++; document.getElementById('length-display').textContent = state.length; updatePrice(); }
  });

  // Charms (max 3)
  document.querySelectorAll('.charm-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.charm;
      if (btn.classList.contains('active')) {
        btn.classList.remove('active');
        state.charms = state.charms.filter(c => c !== id);
      } else if (state.charms.length < 3) {
        btn.classList.add('active');
        state.charms.push(id);
      }
      updatePrice();
    });
  });

  // Booking form
  document.getElementById('booking-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(e.target);
    alert(`Thanks, ${data.get('name')}! Your appointment request has been received. We'll confirm within 24 hours and send a link for your $25 deposit.`);
    e.target.reset();
  });
</script>
