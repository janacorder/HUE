---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="HUE Co. — The Chain Bar · Permanent Jewelry · Santa Cruz"
  description="The Chain Bar by HUE Co. Permanent jewelry welded to your exact body. No clasp. No compromise. Three tiers, seven body locations. Santa Cruz, CA."
>

<!-- ── Hero ──────────────────────────────────────────────── -->
<section class="hero section--dark">
  <div class="hero__inner container">
    <span class="eyebrow eyebrow--light">Permanent Jewelry Studio · Santa Cruz, CA</span>
    <h1 class="hero__headline">
      <em>The Chain Bar</em>
    </h1>
    <p class="hero__byline">by HUE Co.</p>
    <p class="hero__sub">
      Welded to your body in ten seconds flat.<br />
      No clasp. No compromise. No coming off.
    </p>
    <div class="hero__ctas">
      <a href="/book" class="btn btn--gold">Book a Weld</a>
      <a href="/about" class="btn btn--outline">Explore the Studio</a>
    </div>
  </div>
  <div class="hero__scroll">scroll</div>

  <!-- Bottom scallop -->
  <div class="scallop scallop--down" style="color: var(--butter);">
    <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
      <path d="M0,40 C120,0 240,40 360,20 C480,0 600,40 720,20 C840,0 960,40 1080,20 C1200,0 1320,40 1440,20 L1440,40 Z" fill="currentColor"/>
    </svg>
  </div>
</section>

<!-- ── Marquee Strip ──────────────────────────────────────── -->
<div class="marquee-section section--butter">
  <div class="marquee">
    <div class="marquee__track">
      <span class="marquee__item">PERMANENT JEWELRY</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">SANTA CRUZ</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">NO CLASP</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">NO COMPROMISE</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">THE CHAIN BAR</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">WELDED TO YOU</span>
      <span class="marquee__item">&middot;</span>
      <!-- Duplicate for seamless loop -->
      <span class="marquee__item">PERMANENT JEWELRY</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">SANTA CRUZ</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">NO CLASP</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">NO COMPROMISE</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">THE CHAIN BAR</span>
      <span class="marquee__item">&middot;</span>
      <span class="marquee__item">WELDED TO YOU</span>
      <span class="marquee__item">&middot;</span>
    </div>
  </div>
</div>

<!-- ── The Experience ─────────────────────────────────────── -->
<section class="section section--cream experience">
  <div class="container">
    <div class="experience__grid">

      <!-- Photo -->
      <div class="experience__photo">
        <div class="photo-block photo-block--warm photo-block--tall"></div>
      </div>

      <!-- Text -->
      <div class="experience__text">
        <span class="eyebrow eyebrow--dark">The Experience</span>
        <h2 class="experience__headline">
          Not jewelry you put on.<br />
          <em>Jewelry that becomes you.</em>
        </h2>
        <div class="rule"></div>
        <p class="experience__body">
          We size the chain directly on your wrist, ankle, finger, or neck — then weld
          it shut with a single micro-pulse. No clasp to fidget with. No clasp to lose.
          No clasp at all.
        </p>
        <ul class="experience__points">
          <li>
            <span class="experience__point-num">01</span>
            <span>Choose your chain style, length, and metal tier</span>
          </li>
          <li>
            <span class="experience__point-num">02</span>
            <span>We size and fit the chain live on your body</span>
          </li>
          <li>
            <span class="experience__point-num">03</span>
            <span>A single spark-free pulse welds the ends together permanently</span>
          </li>
        </ul>
        <a href="/services" class="btn btn--outline-dark mt-lg">View All Services</a>
      </div>

    </div>
  </div>

  <!-- Bottom scallop -->
  <div class="scallop scallop--down" style="color: var(--black);">
    <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
      <path d="M0,40 C120,0 240,40 360,20 C480,0 600,40 720,20 C840,0 960,40 1080,20 C1200,0 1320,40 1440,20 L1440,40 Z" fill="currentColor"/>
    </svg>
  </div>
</section>

<!-- ── Three Tiers ────────────────────────────────────────── -->
<section class="section section--dark tiers-section" id="tiers">
  <div class="container">
    <div class="section-header section-header--center">
      <span class="eyebrow">Choose Your Metal</span>
      <h2 class="section-title">Three Tiers</h2>
      <p class="section-subtitle text-center" style="margin-inline:auto;">
        Every tier is permanently welded to your body. The difference is the metal,
        the price point, and the statement you're making.
      </p>
    </div>

    <div class="tiers">

      <!-- T1 -->
      <div class="tier-card card--dark">
        <span class="tier-card__label">T1</span>
        <h3 class="tier-card__name">Durable Utility</h3>
        <p class="tier-card__material">Stainless Steel PVD</p>
        <div class="tier-card__price">from <strong>$42</strong></div>
        <ul class="tier-card__features">
          <li>— Waterproof and gym-proof</li>
          <li>— PVD color coating options</li>
          <li>— Will not tarnish or rust</li>
          <li>— 30-day weld warranty</li>
        </ul>
        <a href="/book?tier=1" class="btn btn--outline" style="width:100%; justify-content:center;">Select T1</a>
      </div>

      <!-- T2 — Featured -->
      <div class="tier-card tier-card--featured card--dark">
        <div class="tier-card__badge">Most Popular</div>
        <span class="tier-card__label">T2</span>
        <h3 class="tier-card__name">Refined Luxury</h3>
        <p class="tier-card__material">14k Gold-Filled · Argentium Silver</p>
        <div class="tier-card__price">from <strong>$72</strong></div>
        <ul class="tier-card__features">
          <li>— Hypoallergenic</li>
          <li>— Tarnish resistant</li>
          <li>— Wears like fine jewelry</li>
          <li>— 30-day weld warranty</li>
        </ul>
        <a href="/book?tier=2" class="btn btn--gold" style="width:100%; justify-content:center;">Select T2</a>
      </div>

      <!-- T3 -->
      <div class="tier-card card--dark">
        <span class="tier-card__label">T3</span>
        <h3 class="tier-card__name">Solid Gold</h3>
        <p class="tier-card__material">14k Yellow Gold · 14k White Gold</p>
        <div class="tier-card__price">from <strong>$145</strong></div>
        <ul class="tier-card__features">
          <li>— Heirloom quality</li>
          <li>— Melt and resale value</li>
          <li>— Lasts generations</li>
          <li>— 30-day weld warranty</li>
        </ul>
        <a href="/book?tier=3" class="btn btn--outline" style="width:100%; justify-content:center;">Select T3</a>
      </div>

    </div>

    <p class="tiers-footnote">
      Not sure which tier? <a href="/learn/tier-guide">Read the full tier guide</a>
    </p>
  </div>
</section>

<!-- ── The Numbers ────────────────────────────────────────── -->
<section class="section section--cream numbers-section">
  <div class="container">
    <div class="numbers-grid">
      <div class="numbers-item">
        <span class="stat-number">3</span>
        <p class="stat-label">Metal Tiers</p>
      </div>
      <div class="numbers-divider"></div>
      <div class="numbers-item">
        <span class="stat-number">7</span>
        <p class="stat-label">Body Locations</p>
      </div>
      <div class="numbers-divider"></div>
      <div class="numbers-item">
        <span class="stat-number">30</span>
        <p class="stat-label">Day Warranty</p>
      </div>
      <div class="numbers-divider"></div>
      <div class="numbers-item">
        <span class="stat-number">0</span>
        <p class="stat-label">Clasps. Ever.</p>
      </div>
    </div>
  </div>
</section>

<!-- ── Testimonials ───────────────────────────────────────── -->
<section class="section section--butter testimonials-section">
  <div class="container">
    <div class="section-header section-header--center">
      <span class="eyebrow eyebrow--dark">Inner Circle</span>
      <h2 class="section-title">What they're saying.</h2>
    </div>

    <div class="testimonials-grid">

      <blockquote class="testimonial-card">
        <p class="testimonial-card__quote">
          "I haven't taken it off in eight months. Through a red-eye flight,
          a wedding, and somewhere around 240 showers. It still looks the day
          I walked out of the studio."
        </p>
        <footer class="testimonial-card__footer">
          <span class="testimonial-card__name">Mara T.</span>
          <span class="testimonial-card__location">Santa Cruz, CA</span>
        </footer>
      </blockquote>

      <blockquote class="testimonial-card">
        <p class="testimonial-card__quote">
          "My whole bachelorette group got matching anklets. We still text each
          other photos of them. It became this thread connecting all of us across
          three states."
        </p>
        <footer class="testimonial-card__footer">
          <span class="testimonial-card__name">Josie R.</span>
          <span class="testimonial-card__location">San Francisco, CA</span>
        </footer>
      </blockquote>

      <blockquote class="testimonial-card">
        <p class="testimonial-card__quote">
          "My daughter and I got matching bracelets for her graduation. She moved
          across the country two weeks later. I look at mine every single day."
        </p>
        <footer class="testimonial-card__footer">
          <span class="testimonial-card__name">Diane M.</span>
          <span class="testimonial-card__location">Santa Cruz, CA</span>
        </footer>
      </blockquote>

    </div>
  </div>
</section>

<!-- ── The Studio ─────────────────────────────────────────── -->
<section class="section section--dark studio-section">
  <div class="container">
    <div class="studio-grid">

      <!-- Left: tall photo -->
      <div class="studio-photos">
        <div class="photo-block photo-block--tall photo-block--studio"></div>
        <div class="photo-block photo-block--square photo-block--warm" style="margin-top: 16px; aspect-ratio: 4/3;"></div>
      </div>

      <!-- Right: text -->
      <div class="studio-text">
        <span class="eyebrow">The Studio</span>
        <h2 class="section-title">Built for this.<br /><em>Only this.</em></h2>
        <div class="rule"></div>
        <p class="studio-body">
          HUE Co. is a permanent jewelry studio in Santa Cruz, California —
          designed from the ground up as a dedicated welding environment.
          Not a booth at a craft fair. Not a pop-up table. A full studio
          experience with professional-grade equipment and a welder who has
          done this hundreds of times.
        </p>
        <p class="studio-body" style="margin-top: 20px;">
          Every appointment is one-on-one. You're never rushed. The studio
          is calm, private, and exactly what this kind of moment deserves.
        </p>
        <a href="/about" class="btn btn--outline mt-lg">About the Studio</a>
      </div>

    </div>
  </div>
</section>

<!-- ── Inner Circle CTA ───────────────────────────────────── -->
<section class="section section--cream inner-circle-section">
  <div class="container">
    <div class="inner-circle-inner">
      <span class="eyebrow eyebrow--dark text-center" style="display:block; text-align:center;">Members Only</span>
      <h2 class="inner-circle-headline">Join The Inner Circle.</h2>
      <p class="inner-circle-sub">
        Early access to new chain styles. Member-only events. A birthday discount
        every year. Twenty dollars of referral credit for every friend you bring in.
      </p>
      <form class="inner-circle-form" id="ic-form">
        <input
          type="email"
          class="ic-input"
          placeholder="your@email.com"
          required
          autocomplete="email"
        />
        <button type="submit" class="btn btn--gold">Join Now</button>
      </form>
      <p class="inner-circle-fine">No spam. Unsubscribe anytime. Members get the good stuff.</p>
    </div>
  </div>
</section>

</Layout>

<style is:global>
  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-block: 120px 80px;
    position: relative;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .hero__headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 11vw, 10rem);
    font-weight: 300;
    font-style: italic;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--warm-white);
    margin-bottom: 8px;
  }

  .hero__byline {
    font-family: 'Jost', sans-serif;
    font-size: clamp(0.9rem, 2vw, 1.25rem);
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: 32px;
  }

  .hero__sub {
    font-family: 'Jost', sans-serif;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.6);
    max-width: 44ch;
    margin-bottom: 48px;
  }

  .hero__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero__scroll {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Jost', sans-serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
  }

  /* ── Marquee ─────────────────────────────────────────────── */
  .marquee-section {
    padding-block: 28px;
    overflow: hidden;
  }

  /* ── Experience ──────────────────────────────────────────── */
  .experience {
    padding-bottom: 80px;
  }

  .experience__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }

  .experience__headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 0;
  }

  .experience__headline em {
    font-style: italic;
    color: var(--butter-dark);
  }

  .experience__body {
    font-family: 'Jost', sans-serif;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--charcoal);
    opacity: 0.8;
    margin-top: 0;
    max-width: 52ch;
  }

  .experience__points {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 32px;
  }

  .experience__points li {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--charcoal);
  }

  .experience__point-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--butter-dark);
    flex-shrink: 0;
    width: 24px;
    padding-top: 1px;
  }

  /* ── Tiers ───────────────────────────────────────────────── */
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tier-card {
    padding: 48px 40px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: background-color 0.25s;
  }

  .tier-card:last-child {
    border-right: none;
  }

  .tier-card:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }

  .tier-card--featured {
    background-color: rgba(212, 185, 106, 0.06);
    border-color: var(--butter) !important;
    border-width: 1px;
    border-style: solid;
    margin: -1px;
    z-index: 1;
  }

  .tier-card__badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--butter);
    color: var(--black);
    font-family: 'Jost', sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 16px;
    white-space: nowrap;
  }

  .tier-card__label {
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: 12px;
    display: block;
  }

  .tier-card__name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--warm-white);
    margin-bottom: 8px;
    line-height: 1.1;
  }

  .tier-card__material {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 24px;
    letter-spacing: 0.04em;
  }

  .tier-card__price {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 4px;
  }

  .tier-card__price strong {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem;
    font-weight: 300;
    color: var(--warm-white);
    display: block;
    line-height: 1;
    margin-bottom: 24px;
  }

  .tier-card__features {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }

  .tier-card__features li {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
  }

  .tiers-footnote {
    text-align: center;
    margin-top: 32px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.04em;
  }

  .tiers-footnote a {
    color: var(--butter);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── Numbers ─────────────────────────────────────────────── */
  .numbers-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .numbers-item {
    flex: 1;
    text-align: center;
    padding: 40px 24px;
  }

  .numbers-divider {
    width: 1px;
    height: 80px;
    background-color: var(--cream-dark);
    flex-shrink: 0;
  }

  /* ── Testimonials ────────────────────────────────────────── */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .testimonial-card {
    padding: 40px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background-color: rgba(255, 255, 255, 0.18);
  }

  .testimonial-card__quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.6;
    color: var(--black);
    margin-bottom: 28px;
  }

  .testimonial-card__footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .testimonial-card__name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--black);
    letter-spacing: 0.02em;
  }

  .testimonial-card__location {
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--charcoal);
    opacity: 0.55;
  }

  /* ── Studio Section ──────────────────────────────────────── */
  .studio-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }

  .studio-photos {
    display: flex;
    flex-direction: column;
  }

  .studio-body {
    font-family: 'Jost', sans-serif;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.65);
    max-width: 52ch;
  }

  /* ── Inner Circle ────────────────────────────────────────── */
  .inner-circle-inner {
    text-align: center;
    max-width: 540px;
    margin-inline: auto;
  }

  .inner-circle-headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--black);
    margin-bottom: 20px;
    line-height: 1.1;
  }

  .inner-circle-sub {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--charcoal);
    opacity: 0.7;
    margin-bottom: 40px;
    max-width: 48ch;
    margin-inline: auto;
  }

  .inner-circle-form {
    display: flex;
    gap: 0;
    max-width: 460px;
    margin-inline: auto;
    margin-bottom: 16px;
  }

  .ic-input {
    flex: 1;
    padding: 14px 20px;
    background-color: var(--warm-white);
    border: 1px solid var(--cream-dark);
    border-right: none;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 300;
    color: var(--charcoal);
    transition: border-color 0.2s;
  }

  .ic-input:focus {
    border-color: var(--butter-dark);
    outline: none;
  }

  .ic-input::placeholder {
    color: var(--charcoal);
    opacity: 0.35;
  }

  .inner-circle-fine {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--charcoal);
    opacity: 0.45;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .experience__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .studio-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .tiers {
      grid-template-columns: 1fr;
      border: none;
      gap: 2px;
    }

    .tier-card {
      border-right: none;
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .tier-card--featured {
      margin: 0;
    }
  }

  @media (max-width: 768px) {
