---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="HUE Co. — The Chain Bar · Permanent Jewelry · Santa Cruz, CA"
  description="Permanent jewelry welded to your exact body. No clasp. No compromise. One ten-second spark and it's yours forever. Book your weld in Santa Cruz, CA."
>

  <!-- ── 1. Hero ──────────────────────────────────────────── -->
  <section class="hero section--dark">
    <div class="container hero__inner">

      <div class="hero__text">
        <span class="eyebrow">Santa Cruz, California</span>

        <h1 class="hero__headline">
          <span class="hero__line">The</span>
          <span class="hero__line">Chain Bar</span>
        </h1>

        <p class="hero__byline">by HUE Co.</p>

        <p class="hero__sub">
          Permanent jewelry welded to your exact body. No clasp.
          No compromise. One ten-second spark and it's yours forever.
        </p>

        <div class="hero__ctas">
          <a href="/book" class="btn btn--gold">Book a Weld</a>
          <a href="/services" class="btn btn--outline">Explore the Studio</a>
        </div>
      </div>

      <div class="hero__media">
        <div class="photo-block photo-block--portrait photo-block--warm hero__photo"></div>
      </div>

    </div>
  </section>

  <!-- ── 2. Marquee Strip ──────────────────────────────────── -->
  <div class="marquee-strip section--butter" aria-hidden="true">
    <div class="marquee-strip__track">
      <span class="marquee-strip__segment">PERMANENT JEWELRY &nbsp;&middot;&nbsp; SANTA CRUZ &nbsp;&middot;&nbsp; NO CLASP &nbsp;&middot;&nbsp; NO COMPROMISE &nbsp;&middot;&nbsp; THE CHAIN BAR &nbsp;&middot;&nbsp; WELDED TO YOU &nbsp;&middot;&nbsp;&ensp;</span>
      <span class="marquee-strip__segment">PERMANENT JEWELRY &nbsp;&middot;&nbsp; SANTA CRUZ &nbsp;&middot;&nbsp; NO CLASP &nbsp;&middot;&nbsp; NO COMPROMISE &nbsp;&middot;&nbsp; THE CHAIN BAR &nbsp;&middot;&nbsp; WELDED TO YOU &nbsp;&middot;&nbsp;&ensp;</span>
      <span class="marquee-strip__segment">PERMANENT JEWELRY &nbsp;&middot;&nbsp; SANTA CRUZ &nbsp;&middot;&nbsp; NO CLASP &nbsp;&middot;&nbsp; NO COMPROMISE &nbsp;&middot;&nbsp; THE CHAIN BAR &nbsp;&middot;&nbsp; WELDED TO YOU &nbsp;&middot;&nbsp;&ensp;</span>
    </div>
  </div>

  <!-- ── 3. The Experience ─────────────────────────────────── -->
  <section class="section--cream section exp-section">
    <div class="container exp-grid">

      <div class="exp-photo">
        <div class="photo-block photo-block--portrait photo-block--warm exp-photo-block"></div>
      </div>

      <div class="exp-text">
        <span class="eyebrow eyebrow--dark">The Experience</span>
        <h2 class="section-title exp-headline">
          Not jewelry you put on.<br>Jewelry that becomes you.
        </h2>
        <p class="exp-body">
          We weld each chain directly to your body using a micro-welding tool.
          No heat on skin. No pain. Just a ten-second flash and you walk out
          wearing something permanent.
        </p>

        <ul class="exp-features">
          <li class="exp-feature">Sized to your exact body — not adjustable, because it doesn't need to be</li>
          <li class="exp-feature">Zero clasps, zero closures, zero chance of losing it</li>
          <li class="exp-feature">Three metal tiers from stainless steel to solid gold</li>
        </ul>

        <a href="/services" class="btn btn--outline-dark">View All Services</a>
      </div>

    </div>
  </section>

  <!-- ── 4. Three Tiers ───────────────────────────────────── -->
  <section class="section--dark section tiers-section">
    <div class="container">

      <div class="section-header section-header--center">
        <span class="eyebrow">Choose Your Metal</span>
        <h2 class="section-title">Three Tiers</h2>
      </div>

      <div class="tiers-grid">

        <!-- Tier 01 -->
        <div class="tier-card">
          <span class="tier-label">Tier 01</span>
          <h3 class="tier-name">Durable Utility</h3>
          <p class="tier-material">Stainless Steel PVD</p>
          <div class="tier-price">from $42</div>
          <ul class="tier-features">
            <li>Waterproof &amp; gym-proof</li>
            <li>PVD color coating</li>
            <li>Most affordable</li>
          </ul>
          <a href="/book" class="btn btn--outline">Select This Tier</a>
        </div>

        <!-- Tier 02 (featured) -->
        <div class="tier-card tier-card--featured">
          <span class="tier-label tier-label--gold">Tier 02</span>
          <h3 class="tier-name">Refined Luxury</h3>
          <p class="tier-material">14k Gold-Filled &middot; Argentium Silver</p>
          <div class="tier-price">from $72</div>
          <ul class="tier-features">
            <li>Hypoallergenic</li>
            <li>Tarnish resistant</li>
            <li>Best value luxury</li>
          </ul>
          <a href="/book" class="btn btn--gold">Select This Tier</a>
        </div>

        <!-- Tier 03 -->
        <div class="tier-card">
          <span class="tier-label">Tier 03</span>
          <h3 class="tier-name">Solid Gold</h3>
          <p class="tier-material">14k Yellow Gold &middot; 14k White Gold</p>
          <div class="tier-price">from $145</div>
          <ul class="tier-features">
            <li>Heirloom quality</li>
            <li>Melt &amp; resale value</li>
            <li>Investment piece</li>
          </ul>
          <a href="/book" class="btn btn--outline">Select This Tier</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ── 5. The Numbers ───────────────────────────────────── -->
  <section class="section--cream section--sm stats-section">
    <div class="container">
      <div class="stats-row">

        <div class="stat-item">
          <span class="stat-big-number">3</span>
          <span class="stat-big-label">Metal Tiers</span>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item">
          <span class="stat-big-number">7</span>
          <span class="stat-big-label">Body Locations</span>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item">
          <span class="stat-big-number">30</span>
          <span class="stat-big-label">Day Warranty</span>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item">
          <span class="stat-big-number">0</span>
          <span class="stat-big-label">Clasps Ever</span>
        </div>

      </div>
    </div>
  </section>

  <!-- ── 6. Testimonials ──────────────────────────────────── -->
  <section class="section--dark section testimonials-section">
    <div class="container">

      <div class="section-header section-header--center">
        <span class="eyebrow">What Our Clients Say</span>
      </div>

      <div class="testimonials-grid">

        <div class="testimonial">
          <blockquote class="testimonial__quote">
            "I forget it's there and then remember it's permanent. That's the whole point."
          </blockquote>
          <div class="testimonial__rule"></div>
          <cite class="testimonial__cite">Sarah M. &nbsp;&middot;&nbsp; Santa Cruz</cite>
        </div>

        <div class="testimonial">
          <blockquote class="testimonial__quote">
            "Stacked three on my wrist at the bridal party. Six months later they're still perfect."
          </blockquote>
          <div class="testimonial__rule"></div>
          <cite class="testimonial__cite">Kelsey R. &nbsp;&middot;&nbsp; Los Gatos</cite>
        </div>

        <div class="testimonial">
          <blockquote class="testimonial__quote">
            "The tier guide made me choose gold-filled and I haven't thought about my ankle bracelet since."
          </blockquote>
          <div class="testimonial__rule"></div>
          <cite class="testimonial__cite">Mia T. &nbsp;&middot;&nbsp; Monterey</cite>
        </div>

      </div>
    </div>
  </section>

  <!-- ── 7. Inner Circle CTA ──────────────────────────────── -->
  <section class="section--butter section--sm inner-circle-section">
    <div class="container--narrow inner-circle-inner">
      <span class="eyebrow eyebrow--dark">Join Us</span>
      <h2 class="section-title inner-circle-headline">The Inner Circle</h2>
      <p class="inner-circle-sub">
        Early access to new styles, member events, birthday discounts, and more.
        No spam — just the good stuff.
      </p>

      <form class="inner-circle-form" action="#" method="post">
        <div class="inner-circle-row">
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            class="inner-circle-input"
            required
          />
          <button type="submit" class="btn btn--gold">Join the Circle</button>
        </div>
        <p class="inner-circle-fine">
          By subscribing you agree to receive HUE Co. emails. Unsubscribe anytime.
        </p>
      </form>
    </div>
  </section>

</Layout>

<style is:global>

  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    padding-top: calc(var(--nav-height) + 80px);
    padding-bottom: 80px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: 72px;
    align-items: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__headline {
    display: flex;
    flex-direction: column;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(72px, 12vw, 160px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--warm-white);
    margin-top: 6px;
    margin-bottom: 20px;
  }

  .hero__line {
    display: block;
  }

  .hero__byline {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 13px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: 28px;
  }

  .hero__sub {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(254, 252, 248, 0.62);
    max-width: 380px;
    margin-bottom: 40px;
  }

  .hero__ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero__media {
    display: flex;
    justify-content: flex-end;
  }

  .hero__photo {
    width: 100%;
    max-width: 520px;
    min-height: 580px;
    aspect-ratio: 3 / 4;
  }

  @media (max-width: 920px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .hero__media {
      justify-content: stretch;
    }

    .hero__photo {
      max-width: 100%;
      min-height: 340px;
    }

    .hero__headline {
      font-size: clamp(60px, 18vw, 120px);
    }
  }

  /* ── Marquee Strip ─────────────────────────────────────── */
  .marquee-strip {
    height: 56px;
    display: flex;
    align-items: center;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
  }

  .marquee-strip__track {
    display: inline-block;
    white-space: nowrap;
    animation: marquee 28s linear infinite;
    will-change: transform;
  }

  .marquee-strip__segment {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--black);
    display: inline-block;
  }

  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }

  /* ── Experience ────────────────────────────────────────── */
  .exp-section {
    overflow: hidden;
  }

  .exp-grid {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 80px;
    align-items: center;
  }

  .exp-photo-block {
    width: 100%;
    max-width: 400px;
    min-height: 520px;
  }

  .exp-headline {
    margin-top: 8px;
    margin-bottom: 24px;
    color: var(--charcoal);
  }

  .exp-body {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(42, 40, 32, 0.7);
    max-width: 52ch;
    margin-bottom: 36px;
  }

  .exp-features {
    display: flex;
    flex-direction: column;
    margin-bottom: 40px;
  }

  .exp-feature {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.65;
    color: var(--charcoal);
    border-left: 1px solid var(--butter);
    padding: 11px 0 11px 16px;
  }

  .exp-feature + .exp-feature {
    border-top: none;
  }

  @media (max-width: 960px) {
    .exp-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .exp-photo {
      order: -1;
    }

    .exp-photo-block {
      max-width: 100%;
    }
  }

  /* ── Tiers ─────────────────────────────────────────────── */
  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    align-items: stretch;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tier-card {
    background: rgba(255, 255, 255, 0.03);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    padding: 44px 36px 40px;
    display: flex;
    flex-direction: column;
    transition: background 0.25s var(--ease);
  }

  .tier-card:last-child {
    border-right: none;
  }

  .tier-card:hover {
    background: rgba(255, 255, 255, 0.055);
  }

  .tier-card--featured {
    background: rgba(212, 185, 106, 0.05);
    border: 1px solid var(--butter);
    padding: 56px 44px 52px;
    position: relative;
    margin: -1px;
    z-index: 1;
  }

  .tier-card--featured:hover {
    background: rgba(212, 185, 106, 0.08);
  }

  .tier-label {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.28);
    display: block;
    margin-bottom: 14px;
  }

  .tier-label--gold {
    color: var(--butter);
  }

  .tier-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.7rem;
    font-weight: 400;
    color: var(--warm-white);
    margin-bottom: 6px;
    line-height: 1.15;
  }

  .tier-material {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 24px;
    line-height: 1.55;
  }

  .tier-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 300;
    color: var(--butter);
    line-height: 1;
    margin-bottom: 28px;
    letter-spacing: -0.01em;
  }

  .tier-features {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  .tier-features li {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
    padding-left: 16px;
    position: relative;
    line-height: 1.55;
  }

  .tier-features li::before {
    content: '\2014';
    position: absolute;
    left: 0;
    color: var(--butter);
    opacity: 0.45;
    font-size: 11px;
    top: 1px;
  }

  @media (max-width: 900px) {
    .tiers-grid {
      grid-template-columns: 1fr;
      border: none;
      gap: 1px;
      background: rgba(255, 255, 255, 0.06);
    }

    .tier-card {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .tier-card--featured {
      margin: 0;
    }
  }

  /* ── Stats ─────────────────────────────────────────────── */
  .stats-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-item {
    flex: 1;
    text-align: center;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-big-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(72px, 10vw, 120px);
    font-weight: 300;
    line-height: 1;
    color: var(--butter-dark);
    display: block;
  }

  .stat-big-label {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--charcoal);
    opacity: 0.5;
    margin-top: 10px;
    display: block;
  }

  .stat-divider {
    width: 1px;
    height: 80px;
    background-color: var(--butter);
    opacity: 0.22;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .stats-row {
      flex-wrap: wrap;
      gap: 24px;
    }

    .stat-item {
      flex: 0 0 calc(50% - 12px);
    }

    .stat-divider {
      display: none;
    }
  }

  /* ── Testimonials ──────────────────────────────────────── */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .testimonial__quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-style: italic;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(254, 252, 248, 0.82);
    flex: 1;
    margin-bottom: 28px;
  }

  .testimonial__rule {
    width: 32px;
    height: 2px;
    background-color: var(--butter);
    margin-bottom: 16px;
    flex-shrink: 0;
  }

  .testimonial__cite {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(254, 252, 248, 0.35);
    font-style: normal;
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  /* ── Inner Circle ──────────────────────────────────────── */
  .inner-circle-inner {
    text-align: center;
  }

  .inner-circle-headline {
    margin-top: 8px;
    margin-bottom: 16px;
    color: var(--black);
  }

  .inner-circle-sub {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(10, 10, 10, 0.6);
    max-width: 46ch;
    margin: 0 auto 36px;
  }

  .inner-circle-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .inner-circle-row {
    display: flex;
    width: 100%;
    max-width: 540px;
  }

  .inner-circle-input {
    flex: 1;
    min-width: 0;
    padding: 14px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 300;
    background-color: var(--cream);
    border: 1px solid var(--black);
    border-right: none;
    color: var(--black);
    outline: none;
    transition: border-color 0.2s var(--ease);
  }

  .inner-circle-input::placeholder {
    color: rgba(10, 10, 10, 0.35);
  }

  .inner-circle-input:focus {
    border-color: var(--butter-dark);
  }

  .inner-circle-row .btn--gold {
    flex-shrink: 0;
  }

  .inner-circle-fine {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: rgba(10, 10, 10, 0.38);
    max-width: 46ch;
    text-align: center;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .inner-circle-row {
      flex-direction: column;
    }

    .inner-circle-input {
      border-right: 1px solid var(--black);
      border-bottom: none;
    }

    .inner-circle-input:focus {
      border-color: var(--butter-dark);
    }

    .inner-circle-row .btn--gold {
      width: 100%;
    }
  }

</style>
