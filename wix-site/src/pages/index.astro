---
import Layout from '../layouts/Layout.astro';
---
<Layout title="HUE Glint — No Clasp. No Compromise." description="Permanent jewelry welded to your exact body. Gold, silver, or steel. Three tiers. Seven body locations. One ten-second weld. Yours forever.">

<!-- Hero -->
<section class="hero section--dark">
  <div class="container hero__inner">
    <span class="eyebrow">Permanent Jewelry Studio</span>
    <h1 class="hero__headline">No Clasp.<br /><em>No Compromise.</em></h1>
    <p class="hero__sub">Permanent jewelry welded to your exact body. Gold, silver, or steel.<br />Three tiers. Seven body locations. One ten-second weld. Yours forever.</p>
    <div class="hero__ctas">
      <a href="/book" class="btn btn--gold">Design Your Chain →</a>
      <a href="/book" class="btn btn--outline">Book a Session</a>
    </div>
  </div>
  <div class="hero__scroll">scroll</div>
</section>

<!-- Trust Bar -->
<div class="trust section--cream">
  <div class="container trust__inner">
    <div class="trust__item">
      <span class="trust__num">3</span>
      <span class="trust__label">Metal Tiers</span>
    </div>
    <div class="trust__divider"></div>
    <div class="trust__item">
      <span class="trust__num">7</span>
      <span class="trust__label">Body Locations</span>
    </div>
    <div class="trust__divider"></div>
    <div class="trust__item">
      <span class="trust__num">30</span>
      <span class="trust__label">Day Weld Warranty</span>
    </div>
    <div class="trust__divider"></div>
    <div class="trust__item">
      <span class="trust__num">0</span>
      <span class="trust__label">Clasps. Ever.</span>
    </div>
  </div>
</div>

<!-- How It Works -->
<section class="section section--cream">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow" style="color:#8B7340">The Process</span>
      <h2 class="section-title" style="color:var(--black)">How It Works</h2>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step__num">01</div>
        <h3 class="step__title">Design</h3>
        <p class="step__text">Use our configurator to choose your metal tier, chain style, width, and charms. See your price in real time before you book.</p>
      </div>
      <div class="step__connector"></div>
      <div class="step">
        <div class="step__num">02</div>
        <h3 class="step__title">Book</h3>
        <p class="step__text">A $25 deposit holds your appointment slot. The remainder is settled at the studio on the day of your weld.</p>
      </div>
      <div class="step__connector"></div>
      <div class="step">
        <div class="step__num">03</div>
        <h3 class="step__title">Weld</h3>
        <p class="step__text">Ten seconds. One micro-pulse. Your chain is welded directly to your body — no clasp, no closure, no coming off.</p>
      </div>
    </div>
  </div>
</section>

<!-- Three Tiers -->
<section class="section section--dark" id="tiers">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Choose Your Metal</span>
      <h2 class="section-title">Three Tiers</h2>
      <p class="section-subtitle" style="margin:0 auto;text-align:center">Every tier is permanently welded. The difference is the metal, the price, and the statement you're making.</p>
    </div>
    <div class="tiers">
      <div class="tier">
        <span class="tier__label">Tier 1</span>
        <h3 class="tier__name">Durable Utility</h3>
        <p class="tier__metal">Stainless Steel PVD</p>
        <div class="tier__price">from <strong>$42</strong></div>
        <ul class="tier__details">
          <li>$1.75 / inch</li>
          <li>$30 weld fee</li>
          <li>Waterproof &amp; gym-proof</li>
          <li>PVD color coating</li>
        </ul>
        <a href="/book?tier=1" class="btn btn--outline">Select Tier 1</a>
      </div>
      <div class="tier tier--featured">
        <div class="tier__badge">Most Popular</div>
        <span class="tier__label">Tier 2</span>
        <h3 class="tier__name">Refined Luxury</h3>
        <p class="tier__metal">14k Gold-Filled · Argentium Silver</p>
        <div class="tier__price">from <strong>$72</strong></div>
        <ul class="tier__details">
          <li>$3.75 / inch</li>
          <li>$45 weld fee</li>
          <li>Hypoallergenic</li>
          <li>Tarnish resistant</li>
        </ul>
        <a href="/book?tier=2" class="btn btn--gold">Select Tier 2</a>
      </div>
      <div class="tier">
        <span class="tier__label">Tier 3</span>
        <h3 class="tier__name">Solid Gold</h3>
        <p class="tier__metal">14k Yellow Gold · 14k White Gold</p>
        <div class="tier__price">from <strong>$145</strong></div>
        <ul class="tier__details">
          <li>$10.00 / inch</li>
          <li>$75 weld fee</li>
          <li>Heirloom quality</li>
          <li>Melt &amp; resale value</li>
        </ul>
        <a href="/book?tier=3" class="btn btn--outline">Select Tier 3</a>
      </div>
    </div>
  </div>
</section>

<!-- Services Overview -->
<section class="section section--cream" id="services-overview">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow" style="color:#8B7340">What We Offer</span>
      <h2 class="section-title" style="color:var(--black)">Every Way We Weld</h2>
    </div>
    <div class="services-grid">
      <a href="/services#in-studio" class="service-card">
        <h3>In-Studio Weld</h3>
        <p>One-on-one 30-minute appointment. From $42 · $25 deposit to book.</p>
        <span class="service-card__link">Learn more →</span>
      </a>
      <a href="/services#stacking" class="service-card">
        <h3>Stacking Session</h3>
        <p>3 or more chains welded in one sitting. 10% off every chain in the stack.</p>
        <span class="service-card__link">Learn more →</span>
      </a>
      <a href="/services#glow" class="service-card service-card--featured">
        <h3>Glow &amp; Glint</h3>
        <p>Spray tan + permanent chain the same day. 10% off both services with partner deSoleil.</p>
        <span class="service-card__link">Learn more →</span>
      </a>
      <a href="/services#bridal" class="service-card">
        <h3>Bridal &amp; Bachelorette</h3>
        <p>Mobile pop-up for groups of 4+. Host gets a complimentary Tier 1 chain.</p>
        <span class="service-card__link">Learn more →</span>
      </a>
      <a href="/services#events" class="service-card">
        <h3>Party Favor Events</h3>
        <p>Corporate, birthday, or brand events. From $38/guest. Host gets a free chain.</p>
        <span class="service-card__link">Learn more →</span>
      </a>
      <a href="/collaborations" class="service-card">
        <h3>Collaborations</h3>
        <p>Bring HUE Glint to your venue. Both audiences. One experience.</p>
        <span class="service-card__link">Partner with us →</span>
      </a>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="section section--dark" id="testimonials">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Inner Circle</span>
      <h2 class="section-title">What They're Saying</h2>
    </div>
    <div class="testimonials">
      <blockquote class="testimonial">
        <p>"I haven't taken it off in 8 months. Through a red-eye flight, a wedding, and roughly 240 showers."</p>
        <cite>Inner Circle Member</cite>
      </blockquote>
      <blockquote class="testimonial">
        <p>"My whole bachelorette group got matching anklets. We still text each other photos of them."</p>
        <cite>Bachelorette Pop-Up Client</cite>
      </blockquote>
      <blockquote class="testimonial">
        <p>"My daughter and I got mother-daughter bracelets for her graduation. She's across the country now. I look at mine every day."</p>
        <cite>Studio Client</cite>
      </blockquote>
    </div>
  </div>
</section>

<!-- Email Capture -->
<section class="section section--cream" id="inner-circle">
  <div class="container">
    <div class="email-capture">
      <span class="eyebrow" style="color:#8B7340">Members Only</span>
      <h2 class="email-capture__title" style="color:var(--black)">Join the Inner Circle.</h2>
      <p class="email-capture__sub">Early access to new styles. Member pricing. $20 referral credit for every friend you bring in. Free measurement guide when you sign up.</p>
      <form class="email-form" id="email-form">
        <input type="email" placeholder="your@email.com" required class="email-form__input" />
        <button type="submit" class="btn btn--gold">Join Now</button>
      </form>
      <p class="email-capture__fine">No spam. Unsubscribe anytime.</p>
    </div>
  </div>
</section>

</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    padding-top: var(--nav-height); text-align: center; position: relative;
  }
  .hero__inner { display: flex; flex-direction: column; align-items: center; }
  .hero__headline {
    font-size: clamp(56px, 9vw, 120px); font-weight: 300; line-height: 1.05;
    margin-bottom: 28px; letter-spacing: -0.01em;
  }
  .hero__headline em { color: var(--gold); font-style: italic; }
  .hero__sub { font-size: 16px; color: rgba(255,255,255,0.65); max-width: 520px; margin-bottom: 48px; line-height: 1.7; }
  .hero__ctas { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .hero__scroll {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.3);
  }

  /* Trust Bar */
  .trust { padding: 40px 0; border-bottom: 1px solid rgba(0,0,0,0.08); }
  .trust__inner { display: flex; align-items: center; justify-content: center; gap: 0; }
  .trust__item { display: flex; flex-direction: column; align-items: center; padding: 0 48px; }
  .trust__num { font-family: 'Cormorant Garamond', serif; font-size: 40px; color: var(--gold); line-height: 1; margin-bottom: 6px; }
  .trust__label { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(0,0,0,0.5); }
  .trust__divider { width: 1px; height: 48px; background: rgba(0,0,0,0.15); }

  /* How It Works */
  .steps { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: start; gap: 0; }
  .step { text-align: center; padding: 32px; }
  .step__num { font-family: 'Cormorant Garamond', serif; font-size: 64px; color: rgba(0,0,0,0.08); line-height: 1; margin-bottom: 16px; }
  .step__title { font-size: 28px; color: var(--black); margin-bottom: 12px; }
  .step__text { font-size: 14px; color: rgba(0,0,0,0.6); line-height: 1.7; }
  .step__connector { width: 1px; background: rgba(0,0,0,0.15); height: 40px; margin-top: 72px; }

  /* Tiers */
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .tier {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    padding: 48px 40px; display: flex; flex-direction: column; gap: 0; position: relative;
  }
  .tier--featured {
    background: rgba(201,168,76,0.08); border-color: var(--gold);
  }
  .tier__badge {
    position: absolute; top: -1px; left: 50%; transform: translateX(-50%);
    background: var(--gold); color: var(--black); font-size: 10px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 16px;
  }
  .tier__label { font-size: 10px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
  .tier__name { font-size: 28px; margin-bottom: 8px; }
  .tier__metal { font-size: 12px; color: rgba(255,255,255,0.5); margin-bottom: 24px; }
  .tier__price { font-size: 14px; color: rgba(255,255,255,0.5); margin-bottom: 8px; }
  .tier__price strong { font-family: 'Cormorant Garamond', serif; font-size: 40px; color: var(--white); font-weight: 400; }
  .tier__details { list-style: none; margin: 16px 0 32px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .tier__details li { font-size: 13px; color: rgba(255,255,255,0.6); padding-left: 16px; position: relative; }
  .tier__details li::before { content: '—'; position: absolute; left: 0; color: var(--gold); }
  .tier .btn { text-align: center; width: 100%; }

  /* Services Grid */
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .service-card {
    background: rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.08);
    padding: 40px 32px; transition: all 0.2s; display: block;
    color: var(--black);
  }
  .service-card:hover { background: rgba(0,0,0,0.07); }
  .service-card--featured { background: rgba(201,168,76,0.06); border-color: rgba(139,115,64,0.3); }
  .service-card h3 { font-size: 22px; margin-bottom: 12px; }
  .service-card p { font-size: 13px; color: rgba(0,0,0,0.6); line-height: 1.6; margin-bottom: 20px; }
  .service-card__link { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: #8B7340; }

  /* Testimonials */
  .testimonials { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .testimonial { padding: 40px; border: 1px solid rgba(255,255,255,0.08); }
  .testimonial p { font-family: 'Cormorant Garamond', serif; font-size: 20px; font-style: italic; line-height: 1.5; margin-bottom: 24px; color: rgba(255,255,255,0.85); }
  .testimonial cite { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); font-style: normal; }

  /* Email Capture */
  .email-capture { text-align: center; max-width: 560px; margin: 0 auto; }
  .email-capture__title { font-size: clamp(36px, 5vw, 56px); margin-bottom: 20px; }
  .email-capture__sub { font-size: 14px; color: rgba(0,0,0,0.6); line-height: 1.7; margin-bottom: 40px; }
  .email-form { display: flex; gap: 0; max-width: 440px; margin: 0 auto 16px; }
  .email-form__input {
    flex: 1; padding: 14px 20px; border: 1px solid rgba(0,0,0,0.2); background: var(--white);
    font-family: 'Montserrat', sans-serif; font-size: 13px; outline: none;
  }
  .email-form__input:focus { border-color: rgba(139,115,64,0.5); }
  .email-capture__fine { font-size: 11px; color: rgba(0,0,0,0.4); letter-spacing: 0.06em; }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; }
    .step__connector { display: none; }
    .tiers, .services-grid, .testimonials { grid-template-columns: 1fr; }
    .trust__inner { flex-wrap: wrap; gap: 24px; }
    .trust__divider { display: none; }
    .trust__item { padding: 0 24px; }
    .email-form { flex-direction: column; }
  }
</style>

<script>
  document.getElementById('email-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = e.target.querySelector('input');
    alert(`Thanks! ${input.value} has been added to the Inner Circle.`);
    input.value = '';
  });
</script>
