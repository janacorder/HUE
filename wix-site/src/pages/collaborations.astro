---
import Layout from '../layouts/Layout.astro';
const industries = [
  { name: 'Blow Dry Bar', icon: '💇' },
  { name: 'Wine Bar — Sip & Glint', icon: '🍷' },
  { name: 'Nail Studio', icon: '💅' },
  { name: 'Yoga Studio', icon: '🧘' },
  { name: 'Bridal Boutique', icon: '👰' },
  { name: 'Floral Designer', icon: '🌸' },
  { name: 'Fitness Studio', icon: '🏋️' },
  { name: 'Hotel / Resort', icon: '🏨' },
  { name: 'Boutique Clothing', icon: '👗' },
  { name: 'Tattoo Studio', icon: '🖊️' },
  { name: 'Spa / Med Spa', icon: '🌿' },
  { name: 'Event Venue', icon: '✨' },
];
---
<Layout title="Collaborations — HUE Glint" description="Your venue. Our studio. Both audiences. Partner with HUE Glint for pop-up events, activations, and ongoing referral relationships.">

<!-- Hero -->
<section class="page-hero section--dark">
  <div class="container">
    <span class="eyebrow">Partner With Us</span>
    <h1 class="page-hero__title">Your venue.<br /><em>Our studio.</em><br />Both audiences.</h1>
    <p class="page-hero__sub">We bring a fully portable welding setup to your space. Your clients discover HUE Glint. Our clients discover you. The host always walks away with a free chain.</p>
    <a href="#inquire" class="btn btn--gold" style="margin-top:40px">Start a Collaboration →</a>
  </div>
</section>

<!-- Featured Partner -->
<section class="section section--cream" id="partner">
  <div class="container">
    <div class="featured-partner">
      <div class="featured-partner__badge">Featured Partner</div>
      <div class="featured-partner__inner">
        <div>
          <span class="eyebrow" style="color:#8B7340">Current Collaboration</span>
          <h2>deSoleil Spray Tanning</h2>
          <p>Our standing partnership with Santa Cruz's premier spray tan studio. Book a Glow &amp; Glint package — professional spray tan and permanent chain on the same day — and save 10% on both services.</p>
          <p>This is what collaboration looks like in practice: two complementary services, one afternoon, one beautiful result.</p>
          <div class="featured-partner__perks">
            <div class="perk">
              <strong>10%</strong>
              <span>off both services</span>
            </div>
            <div class="perk">
              <strong>Same-day</strong>
              <span>booking available</span>
            </div>
            <div class="perk">
              <strong>Both studios</strong>
              <span>in Santa Cruz</span>
            </div>
          </div>
          <a href="/book" class="btn btn--outline-dark">Book Glow &amp; Glint</a>
        </div>
        <div class="featured-partner__visual"></div>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="section section--dark" id="how-it-works">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">The Model</span>
      <h2 class="section-title">How Collaborations Work</h2>
    </div>
    <div class="collab-steps">
      <div class="collab-step">
        <div class="collab-step__num">01</div>
        <h3>You Host</h3>
        <p>Offer your space, your audience, and your promotion channels. We do all the setup, the welding, and the cleanup. You don't need any equipment or expertise.</p>
      </div>
      <div class="collab-step__arrow">→</div>
      <div class="collab-step">
        <div class="collab-step__num">02</div>
        <h3>We Bring the Studio</h3>
        <p>Our portable setup fits in any space — a boutique back room, a hotel suite, a studio lobby. We bring the welder, the chains, the charms, and the whole HUE Glint experience.</p>
      </div>
      <div class="collab-step__arrow">→</div>
      <div class="collab-step">
        <div class="collab-step__num">03</div>
        <h3>Both Brands Win</h3>
        <p>Your clients get a memorable experience they'll talk about. Our clients discover your space. And as the host, you always receive a complimentary chain on us.</p>
      </div>
    </div>
  </div>
</section>

<!-- Industry Concepts -->
<section class="section section--cream" id="industries">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow" style="color:#8B7340">Who We Work With</span>
      <h2 class="section-title" style="color:var(--black)">Industries That Fit</h2>
      <p class="section-subtitle" style="margin:0 auto;text-align:center;color:rgba(0,0,0,0.6)">If your clients value beauty, experience, and something that lasts — there's a collab here.</p>
    </div>
    <div class="industries-grid">
      {industries.map(ind => (
        <div class="industry-card">
          <span class="industry-card__icon">{ind.icon}</span>
          <span class="industry-card__name">{ind.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Inquiry Form -->
<section class="section section--dark" id="inquire">
  <div class="container">
    <div class="inquiry-wrap">
      <div class="inquiry-header">
        <span class="eyebrow">Get In Touch</span>
        <h2>Start a Collaboration</h2>
        <p>Tell us about your business and what you have in mind. We respond within 48 hours.</p>
      </div>
      <form class="inquiry-form" id="collab-form">
        <div class="form-row">
          <div class="form-group">
            <label>Business Name</label>
            <input type="text" name="businessName" placeholder="Your Business" required />
          </div>
          <div class="form-group">
            <label>Industry</label>
            <input type="text" name="industry" placeholder="e.g. Blow Dry Bar" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Contact Name</label>
            <input type="text" name="contactName" placeholder="Your Name" required />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="you@yourbusiness.com" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Phone</label>
            <input type="tel" name="phone" placeholder="(831) 000-0000" />
          </div>
          <div class="form-group">
            <label>Event Type</label>
            <select name="eventType">
              <option value="">Select event type</option>
              <option>One-Time Pop-Up Event</option>
              <option>Recurring Monthly Pop-Up</option>
              <option>Standing Referral Partnership</option>
              <option>Private Party / Corporate Event</option>
              <option>Bachelorette Party</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Message</label>
          <textarea name="message" rows="5" placeholder="Tell us about your space, audience, and what you have in mind..."></textarea>
        </div>
        <button type="submit" class="btn btn--gold">Send Inquiry →</button>
        <p class="form-note">We respond within 48 hours.</p>
      </form>
    </div>
  </div>
</section>

</Layout>

<style>
  .page-hero { padding: calc(var(--nav-height) + 80px) 0 80px; }
  .page-hero__title { font-size: clamp(40px, 6vw, 88px); font-weight: 300; line-height: 1.05; margin-bottom: 20px; }
  .page-hero__title em { color: var(--gold); font-style: italic; }
  .page-hero__sub { font-size: 16px; color: rgba(255,255,255,0.6); max-width: 480px; line-height: 1.7; }

  /* Featured Partner */
  .featured-partner { border: 1px solid rgba(0,0,0,0.1); }
  .featured-partner__badge {
    background: var(--black); color: var(--gold); padding: 8px 20px;
    font-size: 10px; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase;
    display: inline-block;
  }
  .featured-partner__inner { display: grid; grid-template-columns: 1fr 320px; gap: 64px; padding: 56px; align-items: center; }
  .featured-partner h2 { font-size: 40px; margin-bottom: 20px; }
  .featured-partner p { font-size: 15px; color: rgba(0,0,0,0.65); line-height: 1.7; margin-bottom: 16px; }
  .featured-partner__perks { display: flex; gap: 32px; margin: 32px 0; }
  .perk { display: flex; flex-direction: column; }
  .perk strong { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 400; color: #8B7340; line-height: 1; }
  .perk span { font-size: 11px; color: rgba(0,0,0,0.5); letter-spacing: 0.06em; margin-top: 4px; }
  .featured-partner__visual { background: rgba(139,115,64,0.1); min-height: 280px; border-radius: 2px; }

  /* Collab Steps */
  .collab-steps { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: start; gap: 0; }
  .collab-step { padding: 40px; }
  .collab-step__num { font-family: 'Cormorant Garamond', serif; font-size: 56px; color: rgba(255,255,255,0.07); line-height: 1; margin-bottom: 16px; }
  .collab-step h3 { font-size: 26px; margin-bottom: 12px; }
  .collab-step p { font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.7; }
  .collab-step__arrow { font-size: 24px; color: var(--gold); align-self: center; padding: 0 8px; opacity: 0.5; }

  /* Industries */
  .industries-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .industry-card {
    background: rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.08);
    padding: 32px 24px; display: flex; flex-direction: column; align-items: center;
    text-align: center; gap: 12px; transition: background 0.2s;
  }
  .industry-card:hover { background: rgba(0,0,0,0.08); }
  .industry-card__icon { font-size: 28px; }
  .industry-card__name { font-size: 13px; font-weight: 500; color: var(--black); letter-spacing: 0.04em; }

  /* Inquiry Form */
  .inquiry-wrap { max-width: 720px; margin: 0 auto; }
  .inquiry-header { margin-bottom: 48px; }
  .inquiry-header h2 { font-size: 40px; margin-bottom: 12px; }
  .inquiry-header p { font-size: 14px; color: rgba(255,255,255,0.55); }
  .inquiry-form { display: flex; flex-direction: column; gap: 20px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-group label { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
  .form-group input, .form-group select, .form-group textarea {
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
    color: var(--white); padding: 14px 16px;
    font-family: 'Montserrat', sans-serif; font-size: 13px; outline: none;
    transition: border-color 0.2s;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    border-color: rgba(201,168,76,0.5);
  }
  .form-group select option { background: var(--black); }
  .form-group textarea { resize: vertical; }
  .form-note { font-size: 11px; color: rgba(255,255,255,0.3); letter-spacing: 0.06em; margin-top: 4px; }

  @media (max-width: 900px) {
    .featured-partner__inner { grid-template-columns: 1fr; }
    .featured-partner__visual { min-height: 200px; }
    .collab-steps { grid-template-columns: 1fr; }
    .collab-step__arrow { display: none; }
    .industries-grid { grid-template-columns: repeat(3, 1fr); }
    .form-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .industries-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  document.getElementById('collab-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(e.target);
    alert(`Thanks, ${data.get('contactName')}! We'll be in touch within 48 hours.`);
    e.target.reset();
  });
</script>
