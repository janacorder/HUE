---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'HUE Glint — Permanent Jewelry Studio', description = 'Permanent jewelry welded to your exact body. No clasp. No compromise. Three tiers, seven body locations, one ten-second weld. Yours forever.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

<nav class="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__logo">HUE <span class="nav__star">✦</span> GLINT</a>
    <ul class="nav__links">
      <li><a href="/book" class={currentPath.startsWith('/book') ? 'active' : ''}>Design Your Chain</a></li>
      <li><a href="/services" class={currentPath.startsWith('/services') ? 'active' : ''}>Services</a></li>
      <li><a href="/collaborations" class={currentPath.startsWith('/collaborations') ? 'active' : ''}>Collaborations</a></li>
      <li><a href="/collections" class={currentPath.startsWith('/collections') ? 'active' : ''}>Collections</a></li>
    </ul>
    <a href="/book" class="btn btn--gold nav__cta">Book Now</a>
    <button class="nav__hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<slot />

<footer class="footer section--dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="footer__logo">HUE <span style="color:var(--gold)">✦</span> GLINT</div>
        <p class="footer__tagline">No Clasp. No Compromise.</p>
        <div class="footer__social">
          <a href="#" aria-label="Instagram">IG</a>
          <a href="#" aria-label="TikTok">TT</a>
          <a href="#" aria-label="Pinterest">PT</a>
        </div>
      </div>
      <nav class="footer__nav">
        <div class="footer__col">
          <h4>Services</h4>
          <ul>
            <li><a href="/services#in-studio">In-Studio Weld</a></li>
            <li><a href="/services#stacking">Stacking Session</a></li>
            <li><a href="/services#glow">Glow &amp; Glint</a></li>
            <li><a href="/services#bridal">Bridal &amp; Bachelorette</a></li>
            <li><a href="/services#events">Party Favor Events</a></li>
            <li><a href="/services#reweld">Re-Weld &amp; Aftercare</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Learn</h4>
          <ul>
            <li><a href="#">What Is Permanent Jewelry?</a></li>
            <li><a href="#">Tier Guide</a></li>
            <li><a href="#">Aftercare</a></li>
            <li><a href="#">FAQs</a></li>
            <li><a href="#">HUE Journal</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h4>Studio</h4>
          <ul>
            <li><a href="#">About</a></li>
            <li><a href="/collaborations">Collaborations</a></li>
            <li><a href="#">Gift Cards</a></li>
            <li><a href="#">Inner Circle</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer__bottom">
      <p>&copy; 2025 HUE Co. &nbsp;·&nbsp; glint.hue-co.com</p>
    </div>
  </div>
</footer>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: var(--black); border-bottom: 1px solid rgba(255,255,255,0.08);
    height: var(--nav-height);
  }
  .nav__inner { display: flex; align-items: center; height: 100%; gap: 40px; }
  .nav__logo {
    font-family: 'Cormorant Garamond', serif; font-size: 20px; font-weight: 500;
    letter-spacing: 0.15em; white-space: nowrap; margin-right: auto;
  }
  .nav__star { color: var(--gold); }
  .nav__links { display: flex; list-style: none; gap: 36px; }
  .nav__links a {
    font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(255,255,255,0.65); transition: color 0.2s;
  }
  .nav__links a:hover, .nav__links a.active { color: var(--white); }
  .nav__cta { padding: 10px 24px; font-size: 11px; white-space: nowrap; }
  .nav__hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav__hamburger span { width: 22px; height: 1px; background: var(--white); display: block; }

  .footer { padding: 72px 0 40px; }
  .footer__top { display: grid; grid-template-columns: 280px 1fr; gap: 64px; margin-bottom: 56px; }
  .footer__logo { font-family: 'Cormorant Garamond', serif; font-size: 22px; letter-spacing: 0.15em; margin-bottom: 12px; }
  .footer__tagline { font-size: 12px; color: rgba(255,255,255,0.5); letter-spacing: 0.08em; margin-bottom: 24px; }
  .footer__social { display: flex; gap: 20px; }
  .footer__social a { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; color: rgba(255,255,255,0.5); transition: color 0.2s; }
  .footer__social a:hover { color: var(--gold); }
  .footer__nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .footer__col h4 { font-family: 'Cormorant Garamond', serif; font-size: 16px; font-weight: 500; margin-bottom: 20px; color: var(--gold); }
  .footer__col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .footer__col li a { font-size: 12px; color: rgba(255,255,255,0.5); letter-spacing: 0.04em; transition: color 0.2s; }
  .footer__col li a:hover { color: var(--white); }
  .footer__bottom { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 24px; }
  .footer__bottom p { font-size: 11px; color: rgba(255,255,255,0.35); letter-spacing: 0.08em; }

  @media (max-width: 768px) {
    .nav__links, .nav__cta { display: none; }
    .nav__hamburger { display: flex; }
    .footer__top { grid-template-columns: 1fr; gap: 40px; }
    .footer__nav { grid-template-columns: repeat(2, 1fr); }
    .section { padding: 64px 0; }
    .container { padding: 0 20px; }
  }
</style>

</body>
</html>
