---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'HUE Co. — Permanent Jewelry Studio',
  description = 'Permanent jewelry welded to your exact body. No clasp. No compromise. Three tiers, seven body locations, one ten-second weld. Yours forever.'
} = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ── Navigation ─────────────────────────────────────────── -->
<header class="nav" id="nav">
  <div class="nav__inner container">

    <!-- Logo -->
    <a href="/" class="nav__logo">
      <span class="nav__logo-name">HUE Co.</span>
      <span class="nav__logo-sub">Permanent Jewelry</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav__links" aria-label="Main navigation">

      <!-- Services dropdown -->
      <div class="nav__item nav__item--has-dropdown">
        <a href="/services" class={`nav__link ${currentPath.startsWith('/services') ? 'nav__link--active' : ''}`}>
          Services
          <span class="nav__caret"></span>
        </a>
        <div class="nav__dropdown">
          <div class="nav__dropdown-inner">
            <a href="/services#in-studio" class="nav__dropdown-link">In-Studio Weld</a>
            <a href="/services#stacking" class="nav__dropdown-link">Stacking Session</a>
            <a href="/services#glow" class="nav__dropdown-link">Glow &amp; Glint</a>
            <a href="/services#bridal" class="nav__dropdown-link">Bridal &amp; Bachelorette</a>
            <a href="/services#events" class="nav__dropdown-link">Party Favor Events</a>
            <a href="/services#reweld" class="nav__dropdown-link">Re-Weld &amp; Aftercare</a>
          </div>
        </div>
      </div>

      <!-- Learn dropdown -->
      <div class="nav__item nav__item--has-dropdown">
        <a href="/learn" class={`nav__link ${currentPath.startsWith('/learn') ? 'nav__link--active' : ''}`}>
          Learn
          <span class="nav__caret"></span>
        </a>
        <div class="nav__dropdown">
          <div class="nav__dropdown-inner">
            <a href="/learn/what-is-permanent-jewelry" class="nav__dropdown-link">What Is Permanent Jewelry?</a>
            <a href="/learn/tier-guide" class="nav__dropdown-link">Tier Guide</a>
            <a href="/learn/aftercare" class="nav__dropdown-link">Aftercare</a>
            <a href="/learn/faqs" class="nav__dropdown-link">FAQs</a>
            <a href="/learn/journal" class="nav__dropdown-link">HUE Journal</a>
          </div>
        </div>
      </div>

      <!-- Studio dropdown -->
      <div class="nav__item nav__item--has-dropdown">
        <a href="/about" class={`nav__link ${currentPath === '/about' || currentPath === '/collaborations' || currentPath === '/gift-cards' || currentPath === '/inner-circle' ? 'nav__link--active' : ''}`}>
          Studio
          <span class="nav__caret"></span>
        </a>
        <div class="nav__dropdown">
          <div class="nav__dropdown-inner">
            <a href="/about" class="nav__dropdown-link">About</a>
            <a href="/collaborations" class="nav__dropdown-link">Collaborations</a>
            <a href="/gift-cards" class="nav__dropdown-link">Gift Cards</a>
            <a href="/inner-circle" class="nav__dropdown-link">Inner Circle</a>
          </div>
        </div>
      </div>

      <!-- Collections direct link -->
      <div class="nav__item">
        <a href="/collections" class={`nav__link ${currentPath === '/collections' ? 'nav__link--active' : ''}`}>
          Collections
        </a>
      </div>

    </nav>

    <a href="/book" class="btn btn--gold nav__cta">Book Now</a>

    <!-- Hamburger -->
    <button class="nav__hamburger" id="nav-hamburger" aria-label="Open menu" aria-expanded="false">
      <span class="nav__bar nav__bar--1"></span>
      <span class="nav__bar nav__bar--2"></span>
      <span class="nav__bar nav__bar--3"></span>
    </button>

  </div>
</header>

<!-- ── Mobile Menu ────────────────────────────────────────── -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__inner">

    <div class="mobile-menu__section">
      <div class="mobile-menu__heading">Services</div>
      <a href="/services#in-studio" class="mobile-menu__link">In-Studio Weld</a>
      <a href="/services#stacking" class="mobile-menu__link">Stacking Session</a>
      <a href="/services#glow" class="mobile-menu__link">Glow &amp; Glint</a>
      <a href="/services#bridal" class="mobile-menu__link">Bridal &amp; Bachelorette</a>
      <a href="/services#events" class="mobile-menu__link">Party Favor Events</a>
      <a href="/services#reweld" class="mobile-menu__link">Re-Weld &amp; Aftercare</a>
    </div>

    <div class="mobile-menu__section">
      <div class="mobile-menu__heading">Learn</div>
      <a href="/learn/what-is-permanent-jewelry" class="mobile-menu__link">What Is Permanent Jewelry?</a>
      <a href="/learn/tier-guide" class="mobile-menu__link">Tier Guide</a>
      <a href="/learn/aftercare" class="mobile-menu__link">Aftercare</a>
      <a href="/learn/faqs" class="mobile-menu__link">FAQs</a>
      <a href="/learn/journal" class="mobile-menu__link">HUE Journal</a>
    </div>

    <div class="mobile-menu__section">
      <div class="mobile-menu__heading">Studio</div>
      <a href="/about" class="mobile-menu__link">About</a>
      <a href="/collaborations" class="mobile-menu__link">Collaborations</a>
      <a href="/gift-cards" class="mobile-menu__link">Gift Cards</a>
      <a href="/inner-circle" class="mobile-menu__link">Inner Circle</a>
    </div>

    <div class="mobile-menu__section">
      <a href="/collections" class="mobile-menu__link mobile-menu__link--main">Collections</a>
    </div>

    <a href="/book" class="btn btn--gold mobile-menu__book">Book Now</a>

  </div>
</div>

<!-- ── Page Content ───────────────────────────────────────── -->
<main>
  <slot />
</main>

<!-- ── Footer ─────────────────────────────────────────────── -->
<footer class="footer section--dark">
  <!-- Scallop top edge -->
  <div class="scallop scallop--top" style="color: var(--cream);">
    <svg viewBox="0 0 1440 40" preserveAspectRatio="none">
      <path d="M0,40 C120,0 240,40 360,20 C480,0 600,40 720,20 C840,0 960,40 1080,20 C1200,0 1320,40 1440,20 L1440,40 Z" fill="currentColor"/>
    </svg>
  </div>

  <div class="container">
    <div class="footer__top">

      <!-- Brand -->
      <div class="footer__brand">
        <div class="footer__logo">HUE Co.</div>
        <div class="footer__logo-sub">Permanent Jewelry</div>
        <p class="footer__tagline">Experience Beautifully.</p>
        <p class="footer__handle">@hueco.studio</p>
        <div class="footer__social">
          <a href="https://instagram.com/hueco.studio" class="footer__social-link">Instagram</a>
          <a href="https://tiktok.com/@hueco.studio" class="footer__social-link">TikTok</a>
          <a href="https://pinterest.com/hueco.studio" class="footer__social-link">Pinterest</a>
        </div>
      </div>

      <!-- Services -->
      <div class="footer__col">
        <h4 class="footer__col-heading">Services</h4>
        <ul class="footer__col-list">
          <li><a href="/services#in-studio">In-Studio Weld</a></li>
          <li><a href="/services#stacking">Stacking Session</a></li>
          <li><a href="/services#glow">Glow &amp; Glint</a></li>
          <li><a href="/services#bridal">Bridal &amp; Bachelorette</a></li>
          <li><a href="/services#events">Party Favor Events</a></li>
          <li><a href="/services#reweld">Re-Weld &amp; Aftercare</a></li>
        </ul>
      </div>

      <!-- Learn -->
      <div class="footer__col">
        <h4 class="footer__col-heading">Learn</h4>
        <ul class="footer__col-list">
          <li><a href="/learn/what-is-permanent-jewelry">What Is Permanent Jewelry?</a></li>
          <li><a href="/learn/tier-guide">Tier Guide</a></li>
          <li><a href="/learn/aftercare">Aftercare</a></li>
          <li><a href="/learn/faqs">FAQs</a></li>
          <li><a href="/learn/journal">HUE Journal</a></li>
        </ul>
      </div>

      <!-- Studio -->
      <div class="footer__col">
        <h4 class="footer__col-heading">Studio</h4>
        <ul class="footer__col-list">
          <li><a href="/about">About</a></li>
          <li><a href="/collaborations">Collaborations</a></li>
          <li><a href="/gift-cards">Gift Cards</a></li>
          <li><a href="/inner-circle">Inner Circle</a></li>
          <li><a href="/collections">Collections</a></li>
          <li><a href="/book">Book Now</a></li>
        </ul>
      </div>

    </div>

    <div class="footer__bottom">
      <p>&copy; 2025 HUE Co. &nbsp;&middot;&nbsp; Santa Cruz, CA &nbsp;&middot;&nbsp; theartofhue.com</p>
    </div>
  </div>
</footer>

<!-- ── Navigation Styles ──────────────────────────────────── -->
<style is:global>
  body {
    padding-top: var(--nav-height);
  }

  /* Nav shell */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 200;
    height: var(--nav-height);
    background-color: var(--black);
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 28px,
      rgba(180, 150, 80, 0.05) 28px,
      rgba(180, 150, 80, 0.05) 29px
    );
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 48px;
  }

  /* Logo */
  .nav__logo {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-right: auto;
    flex-shrink: 0;
  }

  .nav__logo-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--warm-white);
    line-height: 1;
  }

  .nav__logo-sub {
    font-family: 'Jost', sans-serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--butter);
    line-height: 1;
  }

  /* Nav links row */
  .nav__links {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
  }

  .nav__item {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .nav__link {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s;
    padding: 0 16px;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav__link:hover,
  .nav__link--active {
    color: var(--warm-white);
  }

  /* Caret */
  .nav__caret {
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    display: inline-block;
    opacity: 0.5;
    transition: transform 0.2s;
  }

  .nav__item--has-dropdown:hover .nav__caret,
  .nav__item--has-dropdown:focus-within .nav__caret {
    transform: rotate(225deg) translateY(-2px);
  }

  /* Dropdown */
  .nav__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
    z-index: 300;
  }

  .nav__item--has-dropdown:hover .nav__dropdown,
  .nav__item--has-dropdown:focus-within .nav__dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav__dropdown-inner {
    background-color: var(--cream);
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 28px,
      rgba(180, 150, 80, 0.08) 28px,
      rgba(180, 150, 80, 0.08) 29px
    );
    border: 1px solid var(--cream-dark);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18);
    padding: 8px 0;
  }

  .nav__dropdown-link {
    display: block;
    padding: 11px 24px;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--charcoal);
    transition: background-color 0.15s, color 0.15s;
  }

  .nav__dropdown-link:hover {
    background-color: var(--cream-dark);
    color: var(--black);
  }

  /* Book CTA */
  .nav__cta {
    flex-shrink: 0;
    padding: 10px 24px;
    font-size: 10px;
  }

  /* Hamburger */
  .nav__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 4px;
    margin-left: auto;
    cursor: pointer;
  }

  .nav__bar {
    display: block;
    width: 22px;
    height: 1px;
    background-color: var(--warm-white);
    transition: transform 0.25s var(--ease), opacity 0.25s;
  }

  .nav__hamburger[aria-expanded="true"] .nav__bar--1 {
    transform: translateY(6px) rotate(45deg);
  }

  .nav__hamburger[aria-expanded="true"] .nav__bar--2 {
    opacity: 0;
  }

  .nav__hamburger[aria-expanded="true"] .nav__bar--3 {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Mobile Menu ─────────────────────────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: var(--nav-height) 0 0 0;
    z-index: 190;
    background-color: var(--black);
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 28px,
      rgba(180, 150, 80, 0.05) 28px,
      rgba(180, 150, 80, 0.05) 29px
    );
    overflow-y: auto;
    transform: translateY(-100%);
    opacity: 0;
    transition: transform 0.35s var(--ease-out), opacity 0.25s;
    pointer-events: none;
  }

  .mobile-menu.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu__inner {
    padding: 40px 24px 60px;
    max-width: 480px;
  }

  .mobile-menu__section {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-menu__section:last-of-type {
    border-bottom: none;
  }

  .mobile-menu__heading {
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: 16px;
  }

  .mobile-menu__link {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.75);
    padding: 8px 0;
    transition: color 0.2s;
    line-height: 1.3;
  }

  .mobile-menu__link:hover {
    color: var(--warm-white);
  }

  .mobile-menu__link--main {
    font-size: 1.8rem;
    color: var(--warm-white);
  }

  .mobile-menu__book {
    margin-top: 8px;
    width: 100%;
    justify-content: center;
    padding: 16px 36px;
    font-size: 11px;
  }

  /* ── Footer ──────────────────────────────────────────────── */
  .footer {
    padding-top: 80px;
    padding-bottom: 40px;
    position: relative;
  }

  .footer__top {
    display: grid;
    grid-template-columns: 260px repeat(3, 1fr);
    gap: 48px;
    margin-bottom: 56px;
    padding-top: 24px;
  }

  .footer__brand {}

  .footer__logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--warm-white);
    margin-bottom: 2px;
  }

  .footer__logo-sub {
    font-family: 'Jost', sans-serif;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--butter);
    margin-bottom: 16px;
  }

  .footer__tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-style: italic;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 8px;
  }

  .footer__handle {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--butter);
    margin-bottom: 20px;
  }

  .footer__social {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer__social-link {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.4);
    transition: color 0.2s;
  }

  .footer__social-link:hover {
    color: var(--butter);
  }

  .footer__col-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-weight: 500;
    color: var(--butter);
    margin-bottom: 20px;
    letter-spacing: 0.04em;
  }

  .footer__col-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__col-list li a {
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s;
  }

  .footer__col-list li a:hover {
    color: var(--warm-white);
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 24px;
  }

  .footer__bottom p {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.28);
  }

  /* ── Responsive Nav ──────────────────────────────────────── */
  @media (max-width: 1024px) {
    .nav__links {
      display: none;
    }

    .nav__cta {
      display: none;
    }

    .nav__hamburger {
      display: flex;
    }

    .nav__inner {
      gap: 0;
    }
  }

  @media (max-width: 768px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('is-open');
    mobileMenu?.classList.toggle('is-open', !isOpen);
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(isOpen));
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Close menu when a link is clicked
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('is-open');
      hamburger?.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  });
</script>

</body>
</html>
